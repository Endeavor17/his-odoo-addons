<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_pack" model="ir.ui.view">
        <field name="name">product.template.form.pack</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="is_pack"/>
            </field>
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="pack_products" string="Article Composé" invisible="not is_pack">
                    <field name="pack_line_ids">
                        <list editable="bottom" string="Pack Products">
                            <field name="product_id"/>
                            <field name="product_qty" string="Quantité"/>
                            <field name="discount" string="Sale discount (%)"/>
                            <field name="product_uom_id" string="Unit of Measure"/>
                            <field name="price_unit" string="Prix"/>
                            <field name="subtotal" string="Sous-total" readonly="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
