<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_job_form_roles" model="ir.ui.view">
        <field name="name">hr.job.form.roles</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Business Roles" groups="base.group_erp_manager">
                    <field name="role_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <button name="action_appliquer_roles" type="object"
                            string="Apply to Holders"
                            class="btn-secondary"
                            confirm="The roles of this position will be reapplied to everyone who holds it. Roles set by hand are not touched."/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="ir_cron_reconcilier_roles" model="ir.cron">
        <field name="name">Core: access gaps (accounts vs posts and roles)</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">model._cron_controler_acces()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
