<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_his_access" model="ir.module.category">
            <field name="name">Socle Groupe HIS</field>
            <field name="description">Acces transverses, communs a tous les metiers.</field>
            <field name="sequence">5</field>
        </record>

        <record id="res_groups_privilege_annuaire" model="res.groups.privilege">
            <field name="name">Annuaire</field>
            <field name="category_id" ref="module_category_his_access"/>
            <field name="sequence">10</field>
        </record>

        <!-- Odoo ouvre « Employes » et « Contacts » a tout utilisateur interne.
             Ce n'est pas absurde en soi, mais chez nous Contacts melange les
             fournisseurs, les entreprises partenaires et — par la delegation de
             his.person vers res.partner — les fiches etudiants et candidats.

             Ce groupe rend cet acces explicite. Il ne donne AUCUN droit metier :
             il rouvre seulement deux portes que le socle referme. -->
        <record id="group_annuaire" model="res.groups">
            <field name="name">Consultation annuaire</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_annuaire"/>
            <field name="comment">Voir l'annuaire des employes et le carnet de contacts. N'ouvre aucun acces metier.</field>
        </record>

        <!-- Audit S-6 : rouvre les etudiants et candidats que
             his_person_core.rule_partner_student_candidate_private ferme. -->
        <record id="rule_partner_all_annuaire" model="ir.rule">
            <field name="name">Contacts : tous (consultation annuaire)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('group_annuaire'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
