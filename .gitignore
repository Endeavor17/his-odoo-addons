# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Odoo
*.log
.odoorc
# config/odoo.conf est versionne (environnement de dev) ; on ignore seulement
# une conf locale deposee a la racine.
/odoo.conf

# Sauvegardes et dumps de base. Ils peuvent peser des centaines de Mo et
# contenir des donnees reelles (candidats, matricules) : jamais dans le depot.
*.sql
*.dump
*.zip
/backups/
/filestore/
/data/

# Secrets et surcharges locales
.env
.env.*
/config/odoo.local.conf

# Outils / IDE
.idea/
.vscode/
*.swp
*~
*.bak
.DS_Store
.ruff_cache/
.pytest_cache/

# Assistants et agents (etat de session local, jamais partage)
/.claude/
/.plans/

# Documents de travail locaux (non versionnes)
/CLAUDE.md
/MDM_Produits_Stock_POS_v1.md
/Plan_Implementation_Stock_Module_Odoo19.md

# ---------------------------------------------------------------------------
# Donnees personnelles — a ne JAMAIS versionner
#
# Les exports d'admission et les listes d'etudiants portent des noms, des
# emails, des telephones et des numeros de badge de personnes reelles. Un
# depot n'est pas un endroit pour ca, meme prive : un depot se clone, se
# fork et se partage, et une donnee poussee une fois reste dans l'historique
# meme apres suppression du fichier.
#
# L'exception explicite plus bas est le fichier d'exemple des tests : il ne
# contient que des personnes inventees.
/imports/
/exports/
*.csv
!his_person_sync_sheets/tests/exemple_export.csv
# Les droits d'acces d'un module Odoo sont un .csv, et sans eux le module est
# inutilisable. Deja suivis, les onze existants ne risquaient rien — mais le
# `security/ir.model.access.csv` du PROCHAIN module serait ignore en silence,
# et son absence ne se voit qu'a l'execution, sur le geste d'un utilisateur.
!*/security/ir.model.access.csv
*.xlsx
*.xls

# Sauvegardes, dumps et filestore. Les sauvegardes reelles vivent dans
# ..\_backups\, hors du depot, precisement pour ne pas pouvoir etre commitees.
*.sql
*.dump
*.tar.gz
/backups/
/_backups/
filestore/

# Secrets. config/odoo.conf reste versionne (cf. plus haut, environnement de
# dev) ; tout ce qui suit ne l'est jamais.
.env
.env.*
*.key
*.pem
/config/*.local.conf

# Notes internes adressees a une personne, pas au depot. Une revue de code
# nominative se transmet de la main a la main : poussee ici, elle devient une
# critique publique d'un collegue, et elle y reste.
/NOTE_TO_ENDEAVOR.md
