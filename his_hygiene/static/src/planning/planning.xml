<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="his_hygiene.Planning">
        <div class="o_hyg_planning o_content p-3 p-md-4">
            <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-3">
                <div>
                    <div class="o_hyg_eyebrow">Planning</div>
                    <h2 class="mb-0 fw-bold text-capitalize" t-esc="monthLabel"/>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <i t-if="state.busy" class="fa fa-spinner fa-spin text-muted"/>
                    <button class="btn btn-outline-secondary" title="Previous month" aria-label="Previous month" t-on-click="() => this.changeMonth(-1)">
                        <i class="oi oi-arrow-left"/>
                    </button>
                    <button class="btn btn-outline-secondary" title="Next month" aria-label="Next month" t-on-click="() => this.changeMonth(1)">
                        <i class="oi oi-arrow-right"/>
                    </button>
                    <button class="btn btn-secondary" t-on-click="copyPreviousMonth">
                        <i class="fa fa-copy me-1"/>Copy previous month
                    </button>
                </div>
            </div>

            <t t-if="state.data">
                <div class="o_hyg_palette mb-3">
                    <span class="o_hyg_palette_label">Brush</span>
                    <button t-foreach="state.data.members" t-as="member" t-key="member.id"
                            class="o_hyg_brush" t-att-class="{ 'o_hyg_brush_active': state.brush === member.id }"
                            t-on-click="() => this.pickBrush(member)">
                        <span class="o_hyg_chip" t-att-style="chipStyle(member)" t-esc="member.initials"/>
                        <span t-esc="member.name"/>
                    </button>
                    <span class="o_hyg_hint">Click a cell to add or remove the selected worker. Shift+click further along the row to repeat the last cell.</span>
                </div>

                <div t-if="!state.data.areas.length" class="alert alert-info">
                    No area yet. Add the places the team cleans in Configuration, Areas.
                </div>

                <div t-else="" class="o_hyg_scroll">
                    <table class="o_hyg_matrix">
                        <thead>
                            <tr>
                                <th class="o_hyg_corner">Area</th>
                                <th t-foreach="state.data.days" t-as="day" t-key="day.date"
                                    t-att-class="{ o_hyg_off: day.off, o_hyg_today: day.today }">
                                    <div class="o_hyg_wd" t-esc="weekdayLetter(day)"/>
                                    <div t-esc="day.day"/>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="buildings" t-as="building" t-key="building.name">
                                <tr class="o_hyg_building">
                                    <th t-esc="building.name"/>
                                    <td t-att-colspan="state.data.days.length"/>
                                </tr>
                                <tr t-foreach="building.areas" t-as="area" t-key="area.id">
                                    <th class="o_hyg_area" t-att-title="area.name" t-esc="area.name.split(' / ').slice(1).join(' / ') or area.name"/>
                                    <td t-foreach="state.data.days" t-as="day" t-key="day.date"
                                        class="o_hyg_cell" t-att-class="cellClass(area, day)"
                                        t-on-click="(ev) => this.onCellClick(area, day, ev)">
                                        <t t-set="c" t-value="this.cell(area, day)"/>
                                        <div t-if="c" class="o_hyg_cell_inner">
                                            <t t-foreach="c.employee_ids" t-as="employeeId" t-key="employeeId">
                                                <t t-set="m" t-value="member(employeeId)"/>
                                                <span t-if="m" class="o_hyg_chip"
                                                      t-att-class="{ o_hyg_chip_absent: c.absent_ids.includes(employeeId) }"
                                                      t-att-style="chipStyle(m)" t-att-title="m.name" t-esc="m.initials"/>
                                            </t>
                                            <i t-if="c.done" class="fa fa-check o_hyg_done_mark" title="Done"/>
                                            <span t-if="c.extra" class="o_hyg_extra" title="Extra work">+<t t-esc="c.extra"/></span>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tbody class="o_hyg_absences">
                            <tr class="o_hyg_building">
                                <th>Absences</th>
                                <td t-att-colspan="state.data.days.length" class="text-muted small">Click a day to mark a worker absent; her areas show uncovered until someone else is added.</td>
                            </tr>
                            <tr t-foreach="state.data.members" t-as="member" t-key="member.id">
                                <th class="o_hyg_area">
                                    <span class="o_hyg_chip me-1" t-att-style="chipStyle(member)" t-esc="member.initials"/>
                                    <t t-esc="member.name"/>
                                </th>
                                <td t-foreach="state.data.days" t-as="day" t-key="day.date"
                                    class="o_hyg_cell o_hyg_absence_cell"
                                    t-att-class="{ o_hyg_off: day.off, o_hyg_today: day.today, o_hyg_is_absent: isAbsent(member, day) }"
                                    t-on-click="() => this.onAbsenceClick(member, day)">
                                    <span t-if="isAbsent(member, day)">A</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="o_hyg_legend mt-2">
                    <span><span class="o_hyg_swatch o_hyg_swatch_uncovered"/>Uncovered</span>
                    <span><i class="fa fa-check text-success me-1"/>Done</span>
                    <span><span class="o_hyg_chip o_hyg_chip_absent o_hyg_chip_demo">AB</span>Absent</span>
                    <span><span class="o_hyg_extra">+1</span> Extra work</span>
                    <span><span class="o_hyg_swatch o_hyg_swatch_off"/>Day off</span>
                </div>
            </t>
        </div>
    </t>

</templates>
