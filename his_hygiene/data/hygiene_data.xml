<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Jours sans menage, numeros Python de date.weekday() : 4 = vendredi,
             5 = samedi. -->
        <record id="param_off_weekdays" model="ir.config_parameter">
            <field name="key">his_hygiene.off_weekdays</field>
            <field name="value">4,5</field>
        </record>

        <!-- Categorie des pannes signalees par l'hygiene : la salariee ne
             choisit pas, le chef maintenance reclasse avant de convertir. -->
        <record id="category_reported_by_hygiene" model="maintenance.category">
            <field name="name">Reported by hygiene</field>
            <field name="is_inspection" eval="False"/>
        </record>
    </data>
</odoo>
