<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Une caisse par point de vente, chacune rattachee a son type
             d'operation (et donc a son emplacement). Le reste de la config
             (journaux, moyens de paiement) prend les defauts Odoo. -->

        <record id="pos_config_cafeteria" model="pos.config">
            <field name="name">Cafétéria</field>
            <field name="picking_type_id" ref="picking_type_pos_cafeteria"/>
            <field name="limit_categories" eval="True"/>
            <field name="iface_available_categ_ids" eval="[Command.set([
                ref('pos_categ_boissons'), ref('pos_categ_snacks'),
                ref('pos_categ_chocolat'), ref('pos_categ_biscuits'),
                ref('pos_categ_bonbons'), ref('pos_categ_divers'),
            ])]"/>
        </record>
        <record id="pos_config_restaurant" model="pos.config">
            <field name="name">Restaurant</field>
            <field name="picking_type_id" ref="picking_type_pos_restaurant"/>
            <!-- Le Restaurant ne sert QUE des repas : aucune categorie de
                 vente au detail. L'onglet Repas est ajoute par
                 his_meal_management, a qui les produits appartiennent. -->
            <field name="limit_categories" eval="True"/>
        </record>
        <record id="pos_config_copy_center" model="pos.config">
            <field name="name">Copy Center</field>
            <field name="picking_type_id" ref="picking_type_pos_copy_center"/>
            <field name="limit_categories" eval="True"/>
            <!-- Rien de comestible au Copy Center : fournitures d'etude
                 seulement. L'onglet Recharges vient de his_meal_management. -->
            <field name="iface_available_categ_ids" eval="[Command.set([
                ref('pos_categ_fournitures'),
            ])]"/>
        </record>
    </data>
</odoo>
