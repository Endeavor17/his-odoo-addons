<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- MDM section 4.4. « Marque » existe deja et n'est restreint par aucune
         categorie : allowed_categ_ids vide = pas de restriction, il n'y a donc
         rien a faire dessus.

         NB : le MDM cite « Café / Gaz » parmi les categories eligibles, mais
         cette categorie n'existe pas dans l'arborescence de la section 4.1
         (« Gaz Ghadir » est un produit de Café / Boissons). Non reprise ici ;
         a ajouter si la categorie est creee. -->

    <record id="attribute_format" model="product.attribute">
        <field name="name">Format</field>
        <field name="display_type">radio</field>
        <field name="create_variant">always</field>
        <field name="allowed_categ_ids" eval="[Command.set([
            ref('categ_cafe_boissons'),
            ref('categ_resto_alimentations'),
            ref('categ_resto_epices'),
            ref('categ_menage'),
        ])]"/>
    </record>

    <record id="attribute_variante" model="product.attribute">
        <field name="name">Variante</field>
        <field name="display_type">radio</field>
        <field name="create_variant">always</field>
        <field name="allowed_categ_ids" eval="[Command.set([
            ref('categ_cafe_boissons'),
            ref('categ_resto_alimentations'),
            ref('categ_resto_epices'),
            ref('categ_menage'),
            ref('categ_copy_impression'),
            ref('categ_copy_photocopie'),
        ])]"/>
    </record>

    <!-- Liste controlee Format (MDM 4.4). Variante reste a valeurs libres. -->
    <record id="format_33cl" model="product.attribute.value">
        <field name="name">33CL</field><field name="attribute_id" ref="attribute_format"/><field name="sequence">10</field>
    </record>
