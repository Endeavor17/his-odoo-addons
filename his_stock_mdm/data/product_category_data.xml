    <record id="categ_resto_viandes" model="product.category">
        <field name="default_tracking">none</field>
        <field name="default_use_expiration_date" eval="False"/>
        <field name="property_cost_method">fifo</field>
        <field name="property_valuation">real_time</field>
    </record>

    <!-- ============ Le reste : pas de lot, CUMP (AVCO) ==================== -->
