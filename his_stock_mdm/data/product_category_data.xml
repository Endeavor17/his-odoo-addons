<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Uniquement des mises a jour de categories existantes (cf. mdm_bind_data.xml).
         Aucun <record> createur : l'arborescence est deja en production.

         Tracabilite  : AUCUNE. Le MDM Phase 5 imposait lot + peremption sur le
                        frais Restaurant ; retire le 2026-09-09, cf. migration
                        19.0.1.3.0 et la section « Ecarts assumes » du README.
         Valorisation : MDM Phase 6. FIFO sur le frais Restaurant, CUMP (average)
                        ailleurs. LIFO n'existe pas comme methode de valorisation
                        dans Odoo et n'est pas autorise sous IFRS/SCF. -->

    <!-- ============ Restaurant : frais, FIFO, sans lot ==================== -->
    <!-- La tracabilite par lot a ete retiree le 2026-09-09 (cf. migration
         19.0.1.3.0) : aucun article alimentaire n'est vendu en caisse, la
         contrainte ne pesait donc qu'a la reception, ou elle exigeait un numero
         de lot sur chaque sac de farine. FIFO reste : c'est une decision de
         cout, pas de tracabilite. -->
    <record id="categ_resto_alimentations" model="product.category">
        <field name="default_tracking">none</field>
        <field name="default_use_expiration_date" eval="False"/>
        <field name="property_cost_method">fifo</field>
        <field name="property_valuation">real_time</field>
    </record>
    <record id="categ_resto_fruits" model="product.category">
        <field name="default_tracking">none</field>
        <field name="default_use_expiration_date" eval="False"/>
        <field name="property_cost_method">fifo</field>
        <field name="property_valuation">real_time</field>
    </record>
