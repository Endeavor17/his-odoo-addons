<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Demo only.

             The real catalogue belongs to whoever runs the MDM, not to this
             module: what ships here is the *shape* of a copy product, not a
             price list anyone should sell from. The copy categories are empty
             on a fresh database, and a tour cannot shop in an empty shop.

             The full A4/A3 x N&B/Couleur x Recto/Recto-verso grid for
             Photocopie, so every combination the builder can compose resolves
             to exactly one product - and so the missing-combination path can be
             exercised by asking for an Impression instead. -->

        <record id="product_copy_a4_bw_recto" model="product.template">
            <field name="name">Photocopie A4 N&amp;B Recto</field>
            <field name="type">consu</field>
            <field name="list_price">10.0</field>
            <field name="available_in_pos" eval="True"/>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="copy_service">photocopie</field>
            <field name="copy_format">a4</field>
            <field name="copy_color">bw</field>
            <field name="copy_sides">recto</field>
        </record>

