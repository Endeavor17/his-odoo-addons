<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Le papier consomme par les copies : les lignes de mouvement faites
         vers « Consommation Copy Center », par papier puis par semaine. -->
    <record id="action_paper_consumption" model="ir.actions.act_window">
        <field name="name">Paper Consumption</field>
        <field name="res_model">stock.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain" eval="[('location_dest_id.his_copy_consumption', '=', True), ('state', '=', 'done')]"/>
        <field name="context">{'group_by': ['product_id', 'date:week'], 'create': False}</field>
    </record>

    <menuitem id="menu_paper_consumption"
              name="Paper Consumption"
              parent="stock.menu_warehouse_report"
              action="action_paper_consumption"
              sequence="90"/>

</odoo>
