<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Audit S-6 : rouvre les etudiants et candidats que
         his_person_core.rule_partner_student_candidate_private ferme.
         Caisse : un etudiant se retrouve par sa carte repas, parmi les contacts
         charges. Recrutement : un candidat est un contact (hr_recruitment). -->
    <record id="rule_partner_all_pos_recruitment" model="ir.rule">
        <field name="name">Contacts : tous (caisse, recrutement)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user')),
                                    (4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
