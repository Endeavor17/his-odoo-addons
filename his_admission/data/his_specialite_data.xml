<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Les neuf specialites relevees dans la feuille ADMISSIONS, avec leur
             libelle arabe tel qu'il y figure. Le nombre entre parentheses est
             le volume de dossiers observe sur la campagne 2026 — il ne sert
             qu'a montrer que la liste est complete, il n'est pas stocke.

             noupdate : ouvrir ou fermer une specialite est un geste de
             l'Admission, pas une livraison de code. -->

        <record id="spec_info_systemes" model="his.specialite">
            <field name="name">Informatique - Systemes d'information</field>
            <field name="name_arabe">إعلام آلي - أنظمة الإعلام الآلي</field>
            <field name="code">INF-SI</field>
            <field name="domaine_id" ref="domaine_mi"/>
            <field name="cycle">licence</field>
            <field name="sequence">10</field>
        </record>

        <record id="spec_info_securite" model="his.specialite">
            <field name="name">Informatique - Securite des systemes</field>
            <field name="name_arabe">إعلام آلي - أمن أنظمة معلوماتية</field>
            <field name="code">INF-SEC</field>
            <field name="domaine_id" ref="domaine_mi"/>
            <field name="cycle">licence</field>
            <field name="sequence">20</field>
        </record>

        <record id="spec_info_cyber_master" model="his.specialite">
            <field name="name">Informatique - Master cybersecurite</field>
            <field name="name_arabe">إعلام آلي - ماستر امن سيبيراني</field>
            <field name="code">INF-CYB-M</field>
            <field name="domaine_id" ref="domaine_mi"/>
            <field name="cycle">master</field>
            <field name="sequence">30</field>
        </record>

        <record id="spec_st_electronique" model="his.specialite">
            <field name="name">Sciences et Technologies - Electronique</field>
            <field name="name_arabe">علوم و تكنولوجيا - إلكترونيك</field>
            <field name="code">ST-ELC</field>
            <field name="domaine_id" ref="domaine_st"/>
            <field name="cycle">licence</field>
            <field name="sequence">40</field>
        </record>

        <record id="spec_eco_entreprises" model="his.specialite">
            <field name="name">Sciences economiques - Economie et gestion des entreprises</field>
            <field name="name_arabe">علوم اقتصادية - اقتصاد وتسيير المؤسسات</field>
            <field name="code">ECO-GE</field>
            <field name="domaine_id" ref="domaine_segc"/>
            <field name="cycle">licence</field>
            <field name="sequence">50</field>
        </record>

        <record id="spec_eco_mba_master" model="his.specialite">
            <field name="name">Sciences economiques - Master administration des affaires</field>
            <field name="name_arabe">علوم اقتصادية - ماستر إدارة الأعمال</field>
            <field name="code">ECO-MBA-M</field>
            <field name="domaine_id" ref="domaine_segc"/>
            <field name="cycle">master</field>
            <field name="sequence">60</field>
        </record>

        <record id="spec_com_ecommerce" model="his.specialite">
            <field name="name">Sciences commerciales - Commerce electronique</field>
            <field name="name_arabe">علوم تجارية - تجارة إلكترونية</field>
            <field name="code">COM-ECOM</field>
            <field name="domaine_id" ref="domaine_com"/>
            <field name="cycle">licence</field>
            <field name="sequence">70</field>
        </record>

        <record id="spec_ss_psycho" model="his.specialite">
            <field name="name">Sciences sociales - Psychologie clinique</field>
            <field name="name_arabe">علوم اجتماعية - علم النفس العيادي</field>
            <field name="code">SS-PSY</field>
            <field name="domaine_id" ref="domaine_ss"/>
            <field name="cycle">licence</field>
            <field name="sequence">80</field>
        </record>

        <record id="spec_droit_public" model="his.specialite">
            <field name="name">Droit - Droit public</field>
            <field name="name_arabe">حقوق - القانون العام</field>
            <field name="code">DR-PUB</field>
            <field name="domaine_id" ref="domaine_dr"/>
            <field name="cycle">licence</field>
            <field name="sequence">90</field>
        </record>

        <!-- Les quatre specialites Master que le formulaire en ligne offre
             depuis la rentree 2026 et que le catalogue ne portait pas. Relevees
             le 2026-09-06 dans la liste deroulante « Master Field » du
             formulaire GHL publie (brZg6SmcGhxHbqfadH6h) : sans ces records,
             quatre des six choix possibles arrivaient dans Odoo sans
             specialite, donc sans domaine et sans bareme.

             Le libelle arabe est recopie tel qu'il figure dans le formulaire,
             precede du domaine comme le reste du catalogue. C'est cette forme
             que le rapprochement n8n compare par fragment : la changer casse le
             rapprochement, qui est verifie par tools/test_rapprochement.mjs. -->

        <record id="spec_droit_affaires_master" model="his.specialite">
            <field name="name">Droit - Master droit des affaires</field>
            <field name="name_arabe">حقوق - ماستر قانون الأعمال</field>
            <field name="code">DR-AFF-M</field>
            <field name="domaine_id" ref="domaine_dr"/>
            <field name="cycle">master</field>
            <field name="sequence">100</field>
        </record>

        <!-- Sciences de l'education rattachees a Sciences sociales : aucun
             domaine « education » n'existe, et en creer un obligerait a
             inventer un bareme, ce que ce fichier se refuse a faire ailleurs
             (voir his_domaine_data.xml, TODO A7). Le bareme SS ne pese ni les
             maths ni la physique, ce qui convient a un cursus d'orientation. -->
        <record id="spec_educ_orientation_master" model="his.specialite">
            <field name="name">Sciences sociales - Master sciences de l'education, orientation et guidance</field>
            <field name="name_arabe">علوم اجتماعية - ماستر علوم التربية - إرشاد وتوجيه</field>
            <field name="code">SS-ORI-M</field>
            <field name="domaine_id" ref="domaine_ss"/>
            <field name="cycle">master</field>
            <field name="sequence">110</field>
        </record>

        <record id="spec_com_marketing_master" model="his.specialite">
            <field name="name">Sciences commerciales - Master marketing digital</field>
            <field name="name_arabe">علوم تجارية - ماستر تسويق رقمي</field>
            <field name="code">COM-MKD-M</field>
            <field name="domaine_id" ref="domaine_com"/>
            <field name="cycle">master</field>
            <field name="sequence">120</field>
        </record>

        <!-- Le pendant Master de SS-PSY, qui existe en Licence. Deux records
             distincts et non un cycle partage : le catalogue est filtre par
             cycle en amont du rapprochement, une specialite Licence est donc
             invisible a une candidature Master, et inversement. -->
        <record id="spec_ss_psycho_master" model="his.specialite">
            <field name="name">Sciences sociales - Master psychologie clinique</field>
            <field name="name_arabe">علوم اجتماعية - ماستر علم النفس العيادي</field>
            <field name="code">SS-PSY-M</field>
            <field name="domaine_id" ref="domaine_ss"/>
            <field name="cycle">master</field>
            <field name="sequence">130</field>
        </record>

        <!-- Septieme choix Master, releve dans la premiere vraie candidature
             (execution n8n 44, le 2026-09-06) et non dans le releve initial du
             formulaire : le filtre de longueur de ce releve coupait a 80
             caracteres et ce libelle en fait 81. C'est precisement celui que la
             candidate a choisi. Relever une liste deroulante sans plafond. -->
        <record id="spec_info_donnees_master" model="his.specialite">
            <field name="name">Informatique - Master ingenierie des donnees et technologie web</field>
            <field name="name_arabe">إعلام آلي - ماستر هندسة البيانات وتكنولوجيا الويب</field>
            <field name="code">INF-DATA-M</field>
            <field name="domaine_id" ref="domaine_mi"/>
            <field name="cycle">master</field>
            <field name="sequence">140</field>
        </record>

    </data>
</odoo>
