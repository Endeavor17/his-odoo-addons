<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="res_groups_privilege_his_admission" model="res.groups.privilege">
            <field name="name">Admission</field>
            <field name="category_id" ref="his_person_core.module_category_his_person"/>
        </record>

        <!-- L'Admission est une unite distincte des Ventes : le BPMN la pose
             ainsi, et c'est elle qui coche « frais payes » et « contrat
             signe ». Ce groupe est le seul a pouvoir ecrire un dossier.

             Les conseilleres Ventes lisent (cf. ir.model.access.csv) : elles
             suivent leur candidat depuis le lead et repondent a ses questions,
             sans pouvoir valider a la place du back-office. Leur donner
             l'ecriture reviendrait a supprimer la separation que le processus
             existant maintient. -->
        <record id="group_his_admission" model="res.groups">
            <field name="name">Dossier - Instruction</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_his_admission"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Le guichet Finance. Il n'a AUCUN droit d'ecriture sur le dossier :
             ses seules actions sont les boutons d'encaissement, qui ecrivent un
             champ et un seul. Ce n'est pas une politesse d'interface, c'est la
             regle d'acces qui le tient — un guichetier ne peut pas cocher
             « contrat signe » ni corriger une note de BAC, meme par import ou
             par API.

             Provisoire dans sa forme, pas dans son principe : quand le module
             Finance existera, c'est lui qui appellera les memes methodes
             d'encaissement, et ce groupe deviendra celui du service plutot que
             celui des personnes qui saisissent a sa place. -->
        <record id="group_his_finance" model="res.groups">
            <field name="name">Dossier - Guichet</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_his_admission"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>

    <!-- HORS noupdate : une regle d'enregistrement doit pouvoir etre
         corrigee par une livraison. Dans le bloc noupdate, le changement
         de domaine ne s'appliquait pas aux bases deja installees — panne
         silencieuse, la regle restait celle d'avant. -->
    <data>

        <!-- ============ Le pipeline partage ============

             L'Admission voit et deplace les candidatures qu'elle a a
             instruire, sur le MEME tableau que les Ventes. Un seul
             enregistrement, deux equipes : rien a synchroniser, donc rien qui
             puisse deriver. C'est ce qui rend le mot « en phase » litteral.

             Le critere est l'ETAPE atteinte : l'Admission suit le candidat des
             que la conseillere lui a parle. Il a d'abord ete his_person_id, du
             temps ou le pont d'identite se declenchait au premier contact ;
             l'hypothese A1 a place ce declencheur a la pre-admission, et
             garder la fiche comme critere aurait ferme ce tableau sur tout ce
             qui precede.

             UNE SEQUENCE ET NON DES IDENTIFIANTS : un domaine de regle est
             relu par ir.rule._compute_domain avec un contexte qui ne contient
             ni `ref` ni les modeles — seulement `user`, `time` et les
             societes. On ne peut donc pas y nommer une etape. Le nombre 30 est
             la sequence de « Contact etabli », et un test le verifie : si
             quelqu'un reordonne le pipeline, il echoue bruyamment plutot que
             d'ouvrir ou de fermer cet acces en silence.

             Ecriture SANS creation ni suppression (voir ir.model.access.csv) :
             l'Admission fait avancer un candidat, elle n'en invente pas et
             n'en efface pas. Creer reste un geste des Ventes ou de la capture
             web ; perdre reste un geste des Ventes. -->
        <record id="rule_crm_lead_admission" model="ir.rule">
            <field name="name">Candidatures connues de l'Admission</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="groups" eval="[(4, ref('his_admission.group_his_admission'))]"/>
            <field name="domain_force">[('stage_id.sequence', '&gt;=', 30)]</field>
        </record>

    </data>
</odoo>
