<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_his_tarif_list" model="ir.ui.view">
        <field name="name">his.tarif.list</field>
        <field name="model">his.tarif</field>
        <field name="arch" type="xml">
            <list string="Fees" editable="bottom">
                <field name="specialite_id"/>
                <field name="cycle"/>
                <field name="frais_inscription"/>
                <field name="frais_scolarite" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_his_tarif" model="ir.actions.act_window">
        <field name="name">Fees</field>
        <field name="res_model">his.tarif</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No fee recorded.</p>
            <p>While this grid is empty, the cockpit shows NO revenue
               figure. This is deliberate: an invented amount gets quoted in meetings.</p>
            <p>Only one active fee per specialty. To change the scale,
               deactivate the old one rather than editing it — the history
               stays readable.</p>
        </field>
    </record>

    <menuitem id="menu_his_tarif" name="Fees"
              parent="menu_admission_config"
              action="action_his_tarif" sequence="40"/>

</odoo>
