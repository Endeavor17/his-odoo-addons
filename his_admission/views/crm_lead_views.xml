<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_lead_form_admission" model="ir.ui.view">
        <field name="name">crm.lead.form.admission</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="his_crm_identity_bridge.view_crm_lead_form_identity"/>
        <field name="arch" type="xml">

            <field name="his_person_id" position="after">
                <!-- La conseillere suit son candidat apres la passation, sans
                     pouvoir cocher a la place de l'Admission : ses droits sur
                     his.engagement sont en lecture seule (ir.model.access.csv). -->
                <button name="action_ouvrir_dossier_admission" type="object"
                        string="Ouvrir le dossier d'admission" class="btn-link"
                        icon="fa-folder-open-o"
                        invisible="not his_person_id"/>
            </field>

            <!-- Le score cesse d'etre une saisie. Les notes qui le composent
                 remplacent le champ libre : ce sont elles que le formulaire de
                 candidature envoie, et c'est d'elles que la conseillere a
                 besoin pour mener son entretien. -->
            <field name="score_academique" position="replace">
                <field name="specialite_id" options="{'no_create': True}"/>
                <field name="bac_moyenne"/>
                <field name="note_math_utilisee" invisible="1"/>
                <field name="note_physique_utilisee" invisible="1"/>
                <!-- Quelles notes sont exigees depend de la majeure : le
                     domaine dit deja lesquelles il pondere. -->
                <field name="note_math"
                       invisible="not note_math_utilisee"
                       required="note_math_utilisee"/>
                <field name="note_physique"
                       invisible="not note_physique_utilisee"
                       required="note_physique_utilisee"/>
                <field name="score_academique"/>
                <field name="score_detail" invisible="not score_detail"/>
                <!-- Le score du navigateur ne s'affiche QUE s'il diverge. Le
                     montrer en permanence apprendrait a la conseillere a lire
                     deux scores et a choisir ; ne le montrer que sur ecart en
                     fait ce qu'il est, une alerte. -->
                <field name="score_client"
                       invisible="score_client == score_academique"/>
            </field>

            <field name="motivation_notes" position="before">
                <field name="motivation_majeure"
                       placeholder="Pourquoi cette specialite ?"/>
                <field name="motivation_his"
                       placeholder="Pourquoi HIS ?"/>
            </field>

            <!-- Ce que le formulaire recueille et que personne ne lisait dans
                 Odoo : la conseillere devait rouvrir GoHighLevel pour savoir
                 d'ou vient le candidat.

                 Ancre sur motivation_notes et non sur motivation_his : ce
                 dernier est ajoute par CETTE vue, quelques lignes plus haut, et
                 les operations d'heritage s'appliquent dans l'ordre du
                 document — s'ancrer dessus marcherait ici et casserait au
                 premier deplacement de bloc. motivation_notes, lui, vient de la
                 vue heritee. -->
            <field name="motivation_notes" position="after">
                <field name="wilaya"/>
                <field name="bac_annee"/>
                <field name="bac_filiere"/>
                <field name="consentement_18_07"/>
                <field name="date_consentement"
                       invisible="not consentement_18_07"/>
            </field>

        </field>
    </record>

    <!-- La carte du kanban Admissions gagne la specialite demandee.

         Elle vit ici et non dans his_crm_pipeline pour la meme raison que le
         bloc academique du formulaire juste au-dessus : specialite_id est
         apporte par CE module. his_crm_pipeline s'installe seul et ne connait
         pas le referentiel des specialites.

         C'est le seul renseignement que la conseillere lit avant de rappeler :
         le nom dit qui, le score dit s'il faut se depecher, la specialite dit
         de quoi on va parler. -->
    <record id="view_crm_lead_kanban_admission_specialite" model="ir.ui.view">
        <field name="name">crm.lead.kanban.admission.specialite</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="his_crm_pipeline.view_crm_lead_kanban_admissions"/>
        <field name="arch" type="xml">
            <!-- Sur sa propre ligne, sous les badges, et non dans la pastille du
                 score : le libelle d'une specialite porte son nom arabe, il est
                 donc long. Glisse dans la pastille il l'etirait sur toute la
                 largeur de la carte et noyait le score, qui doit rester lisible
                 d'un coup d'oeil. -->
            <xpath expr="//div[hasclass('o_his_lead_kanban_meta')]" position="after">
                <div class="text-muted small text-truncate"
                     invisible="not specialite_id">
                    <field name="specialite_id"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
