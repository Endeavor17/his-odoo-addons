<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="his_pos_finance.OpeningControlPopup" t-inherit="point_of_sale.OpeningControlPopup" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='confirm']" position="attributes">
            <attribute name="t-att-disabled">!env.utils.isValidFloat(state.openingCash) or hisNeedsNote</attribute>
        </xpath>
        <xpath expr="//textarea[@id='openingNotes']" position="after">
            <small t-if="hisNeedsNote" class="text-danger">Explain the difference</small>
        </xpath>
    </t>
    <t t-name="his_pos_finance.ClosePosPopup" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        <xpath expr="//textarea[@id='closingNotes']" position="after">
            <small t-if="hisNeedsNote()" class="text-danger">Explain the difference</small>
        </xpath>
    </t>
</templates>
