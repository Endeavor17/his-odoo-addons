<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_cash_transfer" model="ir.actions.report">
        <field name="name">Cash Transfer Slip</field>
        <field name="model">his.cash.transfer</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">his_pos_finance.report_cash_transfer</field>
        <field name="print_report_name">'Bordereau %s' % object.name</field>
        <field name="binding_model_id" ref="model_his_cash_transfer"/>
    </record>

    <template id="report_cash_transfer">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Cash Transfer Slip <span t-field="o.name"/></h2>
                        <table class="table table-sm">
                            <tr><th>From</th><td><span t-field="o.from_journal_id"/></td></tr>
                            <tr><th>To</th><td><span t-field="o.to_journal_id"/></td></tr>
                            <tr><th>Sent on</th><td><span t-field="o.sent_at"/></td></tr>
                            <tr><th>Amount sent</th><td><span t-field="o.amount_sent"/></td></tr>
                            <tr><th>Amount received</th><td><span t-if="o.state == 'received'" t-field="o.amount_received"/></td></tr>
                            <tr><th>Sent by</th><td><span t-field="o.sent_by"/></td></tr>
                            <tr><th>Received by</th><td><span t-field="o.received_by"/></td></tr>
                            <tr t-if="o.note"><th>Note</th><td><span t-field="o.note"/></td></tr>
                        </table>
                        <div class="row mt-5">
                            <div class="col-6"><strong>Handed over by</strong><br/><br/><br/>Signature</div>
                            <div class="col-6"><strong>Received by</strong><br/><br/><br/>Signature</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
