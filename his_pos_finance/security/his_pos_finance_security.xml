<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Le Responsable du Departement Finance (procedure points de vente §6.3) :
         clot les ecarts importants et majeurs, revoit ceux de la caisse Direction. -->
    <record id="group_finance_head" model="res.groups">
        <field name="name">Finance Head</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="his_purchase_finance.res_groups_privilege_finance"/>
        <field name="implied_ids" eval="[(4, ref('his_purchase_finance.group_finance'))]"/>
        <field name="comment">Closes important and major cash gaps and reviews the Direction cash box gaps.</field>
    </record>

    <record id="rule_discrepancy_company" model="ir.rule">
        <field name="name">Cash discrepancies: own companies</field>
        <field name="model_id" ref="model_his_cash_discrepancy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_transfer_company" model="ir.rule">
        <field name="name">Cash transfers: own companies</field>
        <field name="model_id" ref="model_his_cash_transfer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- Les comptages des caisses Finance et Direction : chacun sa caisse,
         la Finance et la Direction voient tout. -->
    <record id="rule_count_holder" model="ir.rule">
        <field name="name">Cash counts: own cash box</field>
        <field name="model_id" ref="model_his_cash_count"/>
        <field name="domain_force">[('journal_id.his_holder_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_count_finance" model="ir.rule">
        <field name="name">Cash counts: Finance and Direction</field>
        <field name="model_id" ref="model_his_cash_count"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('his_purchase_finance.group_finance')), (4, ref('his_purchase.group_purchase_director'))]"/>
    </record>
</odoo>
