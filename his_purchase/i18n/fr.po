"%(order)s is more than 20%% above the amount the director approved on "
"%(request)s: %(approved)s approved, %(ordered)s ordered."
msgstr "%(order)s dépasse de plus de 20 %% le montant approuvé par le directeur sur %(request)s : %(approved)s approuvés, %(ordered)s commandés."

#. module: his_purchase
#. odoo-python
#: code:addons/his_purchase/models/purchase_order.py:0
msgid ""
"%(order)s orders more than requested on %(request)s. Only a purchase manager"
" can authorise a top-up."
msgstr ""
"%(order)s commande plus que demandé sur %(request)s. Seul un responsable "
"achats peut autoriser un complément."

