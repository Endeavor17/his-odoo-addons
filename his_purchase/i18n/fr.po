#. module: his_purchase
#: model:mail.template,body_html:his_purchase.mail_template_supplier_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Hello,</p>\n"
"    <p>We sent you our request for pro forma <strong t-out=\"object.name or ''\"/> and have not received your answer yet.\n"
"    Could you send us your pro forma (prices, VAT, delivery lead time), or tell us if you cannot supply these items?</p>\n"
"    <p>You will find the request attached again.</p>\n"
"    <p>Best regards,<br/><t t-out=\"object.user_id.name or object.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Bonjour,</p>\n"
"    <p>Nous vous avons adressé notre demande de proforma <strong t-out=\"object.name or ''\"/> et n'avons pas encore reçu votre réponse.\n"
"    Pourriez-vous nous envoyer votre proforma (prix, TVA, délai de livraison), ou nous indiquer si vous ne pouvez pas fournir ces articles ?</p>\n"
"    <p>Vous trouverez la demande à nouveau en pièce jointe.</p>\n"
"    <p>Cordialement,<br/><t t-out=\"object.user_id.name or object.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "

