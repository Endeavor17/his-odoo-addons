"%(order)s is marked as quoted but has lines without a price: %(lines)s."
msgstr ""
"%(order)s est marquée comme chiffrée mais des lignes n'ont pas de prix : "
"%(lines)s."

#. module: his_purchase
#. odoo-python
#: code:addons/his_purchase/models/purchase_order.py:0
