<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="his_purchase_request_list" model="ir.ui.view">
        <field name="name">his.purchase.request.list</field>
        <field name="model">his.purchase.request</field>
        <field name="arch" type="xml">
            <list decoration-danger="his_is_late" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="date_required"/>
                <field name="his_step_since" string="In This Step Since" optional="show"/>
                <field name="estimated_amount" sum="Total" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="his_is_late" column_invisible="1"/>
                <field name="state" widget="badge" decoration-info="state in ('submitted', 'approved', 'sourcing')" decoration-success="state in ('ordered', 'done')"/>
            </list>
        </field>
    </record>

    <record id="his_purchase_request_form" model="ir.ui.view">
        <field name="name">his.purchase.request.form</field>
        <field name="model">his.purchase.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_open_reject" type="object" string="Reject" invisible="state != 'submitted'"/>
                    <button name="action_open_source" type="object" string="Source" class="btn-primary" invisible="state not in ('approved', 'sourcing')" groups="purchase.group_purchase_user"/>
                    <button name="action_remind" type="object" string="Remind" invisible="state not in ('submitted', 'approved', 'sourcing')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('ordered', 'done', 'cancel')"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,sourcing,ordered,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not order_count" groups="purchase.group_purchase_user">
                            <field name="order_count" widget="statinfo" string="Purchase Orders"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Late" bg_color="text-bg-danger" invisible="not his_is_late"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id" readonly="state != 'draft'"/>
                            <field name="department_id" readonly="state != 'draft'"/>
                            <field name="approver_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_required" readonly="state not in ('draft', 'approved')"/>
                            <field name="his_purchase_domain" readonly="state != 'approved'"/>
                            <field name="estimated_amount"/>
                            <field name="user_id" readonly="state in ('done', 'cancel')"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="his_needs_product" invisible="1"/>
                    <div class="alert alert-info" role="alert" invisible="not his_needs_product or state != 'approved'">
                        A line describes an item that is not in the catalogue yet: the stock managers create it, then the purchasing team can request quotes.
                    </div>
                    <field name="justification" placeholder="Why is this purchase needed?" readonly="state != 'draft'"/>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="state not in ('draft', 'approved')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <!-- Le demandeur cherche d'abord dans le catalogue ; sinon il
                                         decrit l'article, que les gestionnaires de stock creeront. -->
                                    <field name="product_id" string="Catalogue Item"/>
                                    <field name="description" string="Or Describe a New Item" required="not product_id"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="estimated_price_unit"/>
                                    <field name="estimated_subtotal" sum="Total"/>
                                    <field name="qty_ordered" optional="show"/>
                                    <field name="his_monthly_requisition_id" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Follow-up" name="followup">
                            <group>
                                <group>
                                    <field name="approved_by_id"/>
                                    <field name="approved_on"/>
                                </group>
                                <group>
                                    <field name="his_step_since" string="In This Step Since"/>
                                    <field name="his_reminder_count"/>
                                    <field name="his_last_nudge"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="his_purchase_request_search" model="ir.ui.view">
        <field name="name">his.purchase.request.search</field>
        <field name="model">his.purchase.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="line_ids" string="Product" filter_domain="['|', ('line_ids.product_id', 'ilike', self), ('line_ids.description', 'ilike', self)]"/>
                <filter name="mine" string="My Requests" domain="[('requester_user_id', '=', uid)]"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'submitted'), ('approver_id', '=', uid)]"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('submitted', 'approved', 'sourcing'))]"/>
                <filter name="late" string="Late" domain="[('his_is_late', '=', True)]"/>
                <filter name="needs_product" string="Waiting for a Catalogue Item" domain="[('state', '=', 'approved'), ('his_needs_product', '=', True)]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_my_requests" model="ir.actions.act_window">
        <field name="name">My Purchase Requests</field>
        <field name="res_model">his.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_mine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ask for a purchase</p>
            <p>Describe what you need and why; your head of department approves it, then the purchasing team buys it.</p>
        </field>
    </record>

    <record id="action_requests_to_approve" model="ir.actions.act_window">
        <field name="name">Requests to Approve</field>
        <field name="res_model">his.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>

    <record id="action_all_requests" model="ir.actions.act_window">
        <field name="name">Purchase Requests</field>
        <field name="res_model">his.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1, 'search_default_group_state': 1}</field>
    </record>

    <template id="weekly_digest_body">
        <div>
            <p><strong t-out="company.name"/> - <t t-out="today"/></p>
            <p>Open purchase requests, oldest first.</p>
            <p t-if="not requests">No open request.</p>
            <table t-if="requests" border="1" cellpadding="4" style="border-collapse: collapse;">
                <tr>
                    <th>Request</th>
                    <th>Requester</th>
                    <th>Status</th>
                    <th>Waiting on</th>
                    <th>Days in this step</th>
                    <th>Required by</th>
                </tr>
                <tr t-foreach="requests" t-as="request">
                    <t t-set="step" t-value="request._his_step()"/>
                    <td><t t-out="request.name"/></td>
                    <td><t t-out="request.requester_id.name"/></td>
                    <td><t t-out="dict(request._fields['state']._description_selection(request.env))[request.state]"/></td>
                    <td><t t-out="', '.join(step['owner'].mapped('name')) if step else (request.user_id.name or '')"/></td>
                    <td><t t-out="(today - request.his_step_since).days if request.his_step_since else ''"/></td>
                    <td><t t-out="request.date_required or ''"/></td>
                </tr>
            </table>
        </div>
    </template>

</odoo>
