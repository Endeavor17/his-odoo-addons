<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Identifiants legaux d'un tiers (societe ou fournisseur). -->
    <template id="legal_block">
        <t t-set="tiers" t-value="partner.commercial_partner_id"/>
        <div class="small">
            <span t-if="tiers.his_rc">RC: <t t-out="tiers.his_rc"/><br/></span>
            <span t-if="tiers.vat">NIF: <t t-out="tiers.vat"/><br/></span>
            <span t-if="tiers.his_nis">NIS: <t t-out="tiers.his_nis"/><br/></span>
            <span t-if="tiers.his_ai">AI: <t t-out="tiers.his_ai"/><br/></span>
            <span t-if="tiers.his_nin and not tiers.is_company">NIN: <t t-out="tiers.his_nin"/></span>
        </div>
    </template>

    <template id="parties_block">
        <div class="row mb-3">
            <div class="col-6">
                <strong>Buyer</strong>
                <div t-out="o.company_id.partner_id" t-options="{'widget': 'contact', 'fields': ['name', 'address', 'phone'], 'no_marker': True}"/>
                <t t-call="his_purchase.legal_block"><t t-set="partner" t-value="o.company_id.partner_id"/></t>
            </div>
            <div class="col-6">
                <strong>Supplier</strong>
                <div t-out="o.partner_id" t-options="{'widget': 'contact', 'fields': ['name', 'address', 'phone', 'email'], 'no_marker': True}"/>
                <t t-call="his_purchase.legal_block"><t t-set="partner" t-value="o.partner_id"/></t>
            </div>
        </div>
    </template>

    <template id="signature_block">
        <div class="row mt-5" style="page-break-inside: avoid;">
            <div t-foreach="signatures" t-as="signature" class="col text-center px-4">
                <strong t-out="signature"/>
                <div style="height: 70px; border-bottom: 1px solid #999; margin: 0 16px;"/>
            </div>
        </div>
    </template>

    <!-- ============ Demande de proforma ============ -->
    <template id="report_proforma_request_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <div class="page">
                <h2>Request for Pro Forma <t t-out="o.name"/></h2>
                <t t-call="his_purchase.parties_block"/>
                <div class="row mb-3">
                    <div class="col-3"><strong>Date</strong><br/><span t-field="o.date_order" t-options="{'widget': 'date'}"/></div>
                    <div class="col-3" t-if="o.his_request_id"><strong>Our request</strong><br/><t t-out="o.his_request_id.name"/></div>
                    <div class="col-3" t-if="o.his_reply_by"><strong>Reply by</strong><br/><span t-field="o.his_reply_by"/></div>
                    <div class="col-3"><strong>Delivery wanted</strong><br/><span t-field="o.date_planned" t-options="{'widget': 'date'}"/></div>
                </div>
                <p>Please send us your pro forma invoice for the items below, with unit prices, VAT, delivery lead time and validity.</p>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-end">Quantity</th>
                            <th>Unit</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.order_line" t-as="line">
                            <t t-if="line.display_type">
                                <td colspan="3"><strong t-out="line.name"/></td>
                            </t>
                            <t t-else="">
                                <td t-out="line.name"/>
                                <td class="text-end"><span t-field="line.product_qty"/></td>
                                <td t-out="line.product_uom_id.name"/>
                            </t>
                        </tr>
                    </tbody>
                </table>
                <div class="row">
                    <div class="col-6">
                        <strong>Delivery address</strong>
                        <div t-out="o._his_delivery_partner()" t-options="{'widget': 'contact', 'fields': ['name', 'address'], 'no_marker': True}"/>
                    </div>
                    <div class="col-6">
                        <strong>Your contact</strong><br/>
                        <t t-out="o.user_id.name"/><br/>
                        <t t-out="o.user_id.email or ''"/><br/>
                        <t t-out="o.user_id.phone or ''"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_proforma_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="his_purchase.report_proforma_request_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!-- ============ Fiche de choix fournisseur ============ -->
    <template id="report_supplier_choice_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Supplier Choice Sheet</h2>
                <div class="row mb-3">
                    <div class="col-3"><strong>Order</strong><br/><t t-out="o.name"/></div>
                    <div class="col-3"><strong>Request</strong><br/><t t-out="o.his_request_id.name or ''"/></div>
                    <div class="col-3"><strong>Requester</strong><br/><t t-out="o.his_request_id.requester_id.name or ''"/></div>
                    <div class="col-3"><strong>Department</strong><br/><t t-out="o.his_request_id.department_id.name or ''"/></div>
                </div>
                <p class="small">Amounts compared with VAT included.</p>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Supplier</th>
                            <th>Answer</th>
                            <th>Pro forma</th>
                            <th class="text-end">Untaxed</th>
                            <th class="text-end">VAT</th>
                            <th class="text-end">Total</th>
                            <th>Promised</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o._his_offers()" t-as="offer" t-att-class="'fw-bold' if offer == o else None">
                            <td><t t-out="offer.partner_id.name"/><t t-if="offer == o"> ✔</t></td>
                            <td><span t-field="offer.his_supplier_answer"/></td>
                            <td><t t-out="offer.his_quote_ref or ''"/> <span t-if="offer.his_quote_date" t-field="offer.his_quote_date"/></td>
                            <t t-if="offer.his_supplier_answer in ('declined', 'no_answer')">
                                <td colspan="3" class="text-center">No offer</td>
                            </t>
                            <t t-else="">
                                <td class="text-end"><span t-field="offer.amount_untaxed"/></td>
                                <td class="text-end"><span t-field="offer.amount_tax"/></td>
                                <td class="text-end"><span t-field="offer.amount_total"/></td>
                            </t>
                            <td><span t-field="offer.date_planned" t-options="{'widget': 'date'}"/></td>
                        </tr>
                    </tbody>
                </table>
                <div class="row">
                    <div class="col-6">
                        <strong>Chosen supplier:</strong> <t t-out="o.partner_id.name"/><br/>
                        <strong>Criterion:</strong> <span t-field="o.his_choice_criterion"/><br/>
                        <t t-if="o.his_choice_note"><strong>Note:</strong> <t t-out="o.his_choice_note"/></t>
                    </div>
                    <div class="col-6">
                        <strong>Chosen by:</strong> <t t-out="o.his_chosen_by_id.name or ''"/> <span t-if="o.his_chosen_on" t-field="o.his_chosen_on" t-options="{'widget': 'date'}"/><br/>
                        <strong>Approved by:</strong> <t t-out="o.his_approved_by_id.name or ''"/> <span t-if="o.date_approve" t-field="o.date_approve" t-options="{'widget': 'date'}"/>
                    </div>
                </div>
                <t t-call="his_purchase.signature_block">
                    <t t-set="signatures" t-value="[o.env._('Purchasing officer'), o.env._('Approver')]"/>
                </t>
            </div>
        </t>
    </template>

    <template id="report_supplier_choice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="his_purchase.report_supplier_choice_document"/>
            </t>
        </t>
    </template>

    <!-- ============ Bon de commande ============ -->
    <template id="report_purchase_order_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <div class="page">
                <h2>Purchase Order <t t-out="o.name"/></h2>
                <t t-call="his_purchase.parties_block"/>
                <div class="row mb-3">
                    <div class="col-3"><strong>Order date</strong><br/><span t-field="o.date_approve" t-options="{'widget': 'date'}"/></div>
                    <div class="col-3"><strong>Delivery</strong><br/><span t-field="o.date_planned" t-options="{'widget': 'date'}"/></div>
                    <div class="col-3" t-if="o.partner_ref"><strong>Your pro forma</strong><br/><t t-out="o.partner_ref"/></div>
                    <div class="col-3" t-if="o.his_request_id"><strong>Our request</strong><br/><t t-out="o.his_request_id.name"/></div>
                </div>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-end">Quantity</th>
                            <th>Unit</th>
                            <th class="text-end">Unit price</th>
                            <th>VAT</th>
                            <th class="text-end">Untaxed</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.order_line" t-as="line">
                            <t t-if="line.display_type">
                                <td colspan="6"><strong t-out="line.name"/></td>
                            </t>
                            <t t-else="">
                                <td t-out="line.name"/>
                                <td class="text-end"><span t-field="line.product_qty"/></td>
                                <td t-out="line.product_uom_id.name"/>
                                <td class="text-end"><span t-field="line.price_unit"/></td>
                                <td t-out="', '.join(line.tax_ids.mapped('name'))"/>
                                <td class="text-end"><span t-field="line.price_subtotal"/></td>
                            </t>
                        </tr>
                    </tbody>
                </table>
                <div class="row">
                    <div class="col-6">
                        <strong>Delivery address</strong>
                        <div t-out="o._his_delivery_partner()" t-options="{'widget': 'contact', 'fields': ['name', 'address'], 'no_marker': True}"/>
                        <p t-if="o.payment_term_id"><strong>Payment terms:</strong> <t t-out="o.payment_term_id.name"/></p>
                    </div>
                    <div class="col-6">
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Total untaxed</strong></td>
                                <td class="text-end"><span t-field="o.amount_untaxed"/></td>
                            </tr>
                            <tr t-foreach="o._his_vat_breakdown()" t-as="vat">
                                <td>VAT <t t-out="vat[0]"/></td>
                                <td class="text-end"><t t-out="vat[2]" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                            </tr>
                            <tr>
                                <td><strong>Total with VAT</strong></td>
                                <td class="text-end"><strong t-field="o.amount_total"/></td>
                            </tr>
                        </table>
                    </div>
                </div>
                <p>This order is set at the sum of: <strong t-out="o._his_amount_in_words()"/>.</p>
                <t t-call="his_purchase.signature_block">
                    <t t-set="signatures" t-value="[o.env._('Approved by'), o.env._('Supplier acknowledgement')]"/>
                </t>
            </div>
        </t>
    </template>

    <template id="report_purchase_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="his_purchase.report_purchase_order_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!-- ============ Bon de reception ============ -->
    <template id="report_goods_receipt_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Goods Receipt <t t-out="o.name"/></h2>
                <div class="row mb-3">
                    <div class="col-3"><strong>Date</strong><br/><span t-field="o.date_done" t-options="{'widget': 'date'}"/><span t-if="not o.date_done" t-field="o.scheduled_date" t-options="{'widget': 'date'}"/></div>
                    <div class="col-3"><strong>Order</strong><br/><t t-out="o.purchase_id.name or o.origin or ''"/></div>
                    <div class="col-3"><strong>Supplier</strong><br/><t t-out="o.partner_id.name or ''"/></div>
                    <div class="col-3"><strong>Received at</strong><br/><t t-out="o.location_dest_id.display_name"/></div>
                </div>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-end">Ordered</th>
                            <th class="text-end">Received</th>
                            <th>Unit</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.move_ids" t-as="move">
                            <td t-out="move.product_id.display_name"/>
                            <td class="text-end"><span t-field="move.product_uom_qty"/></td>
                            <td class="text-end"><span t-field="move.quantity"/></td>
                            <td t-out="move.product_uom.name"/>
                        </tr>
                    </tbody>
                </table>
                <t t-call="his_purchase.signature_block">
                    <t t-set="signatures" t-value="[o.env._('Storekeeper'), o.env._('Delivered by')]"/>
                </t>
            </div>
        </t>
    </template>

    <template id="report_goods_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="his_purchase.report_goods_receipt_document"/>
            </t>
        </t>
    </template>

</odoo>
