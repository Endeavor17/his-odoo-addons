<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_purchase_request" model="res.groups.privilege">
        <field name="name">Purchase Requests</field>
        <field name="sequence">9</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <!-- Pas d'ACL sur base.group_user (politique his_access_base) : demander un
         achat est un role, donne par poste aux seuls responsables (reunion du
         2026-10-20) ; l'acheteur trie leurs demandes, sans etape chef de departement. -->
    <record id="group_requester" model="res.groups">
        <field name="name">Requester</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_purchase_request"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Creates purchase requests and follows them. Give it to the
            Responsable positions only.</field>
    </record>

    <!-- Echelon au-dessus de l'administrateur achats : il approuve les achats
         generaux (decision de Mohamed, 2026-10-15). -->
    <record id="group_purchase_director" model="res.groups">
        <field name="name">Executive Director</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_manager')), (4, ref('group_requester'))]"/>
        <field name="comment">Approves general purchase orders (everything except the points of
            sale), and may approve point-of-sale orders too.</field>
    </record>

    <!-- Le magasinier cree les articles absents du catalogue (2026-10-19) :
         role a part de Inventaire / Administrateur, que portent aussi le
         gestionnaire de stock et les directeurs. -->
    <record id="res_groups_privilege_catalogue" model="res.groups.privilege">
        <field name="name">Catalogue</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_catalogue" model="res.groups">
        <field name="name">Catalogue Manager</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_catalogue"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user')), (4, ref('product.group_product_manager'))]"/>
        <field name="comment">Creates the items that purchase requests describe but the catalogue
            does not have yet, and receives the to-do when such a request is approved.</field>
    </record>

    <record id="purchase.group_purchase_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_requester'))]"/>
    </record>

    <record id="rule_request_company" model="ir.rule">
        <field name="name">Purchase request: multi-company</field>
        <field name="model_id" ref="model_his_purchase_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_request_line_company" model="ir.rule">
        <field name="name">Purchase request line: multi-company</field>
        <field name="model_id" ref="model_his_purchase_request_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Le demandeur voit ses demandes ; le chef de departement celles de son
         departement (et celles qu'il doit approuver). -->
    <record id="rule_request_own" model="ir.rule">
        <field name="name">Purchase request: own and department</field>
        <field name="model_id" ref="model_his_purchase_request"/>
        <field name="groups" eval="[(4, ref('group_requester'))]"/>
        <field name="domain_force">['|', '|', ('requester_user_id', '=', user.id), ('department_id.manager_id.user_id', '=', user.id), ('approver_id', '=', user.id)]</field>
    </record>

    <record id="rule_request_line_own" model="ir.rule">
        <field name="name">Purchase request line: own and department</field>
        <field name="model_id" ref="model_his_purchase_request_line"/>
        <field name="groups" eval="[(4, ref('group_requester'))]"/>
        <field name="domain_force">['|', '|', ('request_id.requester_user_id', '=', user.id), ('request_id.department_id.manager_id.user_id', '=', user.id), ('request_id.approver_id', '=', user.id)]</field>
    </record>

    <record id="rule_request_purchase_user" model="ir.rule">
        <field name="name">Purchase request: all (purchasing)</field>
        <field name="model_id" ref="model_his_purchase_request"/>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_request_line_purchase_user" model="ir.rule">
        <field name="name">Purchase request line: all (purchasing)</field>
        <field name="model_id" ref="model_his_purchase_request_line"/>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Responsables catalogue : ils creent les articles absents du catalogue
         (2026-10-18, role dedie le 2026-10-19). Lecture de toutes les demandes (l'a-faire y mene, et la
         fiche se recharge apres leur saisie) ; ecriture sur les demandes
         approuvees seulement, et le code limite aux champs de l'article. -->
    <record id="rule_request_catalogue_read" model="ir.rule">
        <field name="name">Purchase request: read (catalogue)</field>
        <field name="model_id" ref="model_his_purchase_request"/>
        <field name="groups" eval="[(4, ref('group_catalogue'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_request_catalogue_write" model="ir.rule">
        <field name="name">Purchase request: approved (catalogue)</field>
        <field name="model_id" ref="model_his_purchase_request"/>
        <field name="groups" eval="[(4, ref('group_catalogue'))]"/>
        <field name="domain_force">[('state', '=', 'approved')]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_request_line_catalogue_read" model="ir.rule">
        <field name="name">Purchase request line: read (catalogue)</field>
        <field name="model_id" ref="model_his_purchase_request_line"/>
        <field name="groups" eval="[(4, ref('group_catalogue'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_request_line_catalogue_write" model="ir.rule">
        <field name="name">Purchase request line: approved (catalogue)</field>
        <field name="model_id" ref="model_his_purchase_request_line"/>
        <field name="groups" eval="[(4, ref('group_catalogue'))]"/>
        <field name="domain_force">[('request_id.state', '=', 'approved')]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
