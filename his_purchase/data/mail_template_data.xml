<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_supplier_reminder" model="mail.template">
        <field name="name">Purchase: pro forma reminder</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="subject">Reminder: request for pro forma {{ object.name }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="report_template_ids" eval="[(4, ref('his_purchase.action_report_proforma_request'))]"/>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Hello,</p>
    <p>We sent you our request for pro forma <strong t-out="object.name or ''"></strong> and have not received your answer yet.
    Could you send us your pro forma (prices, VAT, delivery lead time), or tell us if you cannot supply these items?</p>
    <p>You will find the request attached again.</p>
    <p>Best regards,<br/><t t-out="object.user_id.name or object.company_id.name or ''"></t></p>
</div>
        </field>
    </record>
</odoo>
