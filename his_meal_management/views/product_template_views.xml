<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_meal" model="ir.ui.view">
        <field name="name">product.template.form.meal</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="meal_credits"/>
                <field name="meal_validity_days" invisible="meal_credits &lt;= 0"/>
            </xpath>
        </field>
    </record>

    <record id="action_meal_plan" model="ir.actions.act_window">
        <field name="name">Meal Plans</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('meal_credits', '>', 0)]</field>
        <field name="context">{'default_meal_credits': 1, 'default_type': 'service', 'default_available_in_pos': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a meal plan</p>
            <p>A plan is an ordinary product that happens to carry meal credits
               and a validity. Selling it at the point of sale grants the credits.</p>
        </field>
    </record>

</odoo>
