<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_meal" model="ir.ui.view">
        <field name="name">res.partner.form.his</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Identité HIS" name="his_identity">
                    <group>
                        <group string="Identité">
                            <field name="matricule_institutionnel"
                                   placeholder="HIS-2026-000042-7"/>
                            <field name="nom_arabe" placeholder="الاسم بالعربية"/>
                            <field name="type_personne"/>
                            <field name="statut"/>
                        </group>
                        <group string="Contact">
                            <field name="email_institutionnel" widget="email"
                                   placeholder="prenom.nom@his.edu.dz"/>
                            <field name="email_personnel" widget="email"/>
                        </group>
                        <group string="Rattachement">
                            <field name="faculty_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Enseignant" invisible="type_personne != 'enseignant'">
                            <field name="rang_academique"/>
                            <field name="specialite"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        The matricule is issued by HIS and recorded here for later use.
                        Nothing in the meal system depends on it — at the till a person
                        is identified by the card they tap. It is assigned once and
                        never reused, so it cannot be edited after it is saved.
                    </div>
                </page>

                <page string="Meal Account" name="meal_account"
                      invisible="not meal_card_ids">
                    <group>
                        <group string="Card">
                            <field name="meal_card_code" string="Active Card"/>
                        </group>
                        <group string="Balance">
                            <field name="meal_credits_remaining"/>
                            <field name="meal_active_plan"/>
                            <button name="action_open_meal_transactions" type="object"
                                    string="Meal History" class="btn-link" icon="fa-history"/>
                        </group>
                    </group>
                    <separator string="Cards"/>
                    <field name="meal_card_ids" readonly="1">
                        <list>
                            <field name="code"/>
                            <field name="state"/>
                            <field name="create_date"/>
                        </list>
                    </field>
                    <separator string="Subscriptions"/>
                    <field name="meal_subscription_ids" readonly="1">
                        <list>
                            <field name="product_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="credits_total"/>
                            <field name="credits_used"/>
                            <field name="credits_remaining"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_list_meal" model="ir.ui.view">
        <field name="name">res.partner.list.his</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <!-- The card is what identifies someone at the till, so it leads.
                     The matricule is available but hidden by default: it is stored
                     for later and plays no part in day-to-day work. -->
                <field name="meal_card_code" optional="show" string="Card"/>
                <field name="meal_credits_remaining" optional="show" string="Credits"/>
                <field name="type_personne" optional="show"/>
                <field name="matricule_institutionnel" optional="hide"/>
                <field name="nom_arabe" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_partner_search_meal" model="ir.ui.view">
        <field name="name">res.partner.search.his</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <!-- Searching by card number is the common case: it is the number
                     printed on the sheet and read by the reader. -->
                <field name="meal_card_ids" string="Card number"
                       filter_domain="[('meal_card_ids.code', 'ilike', self)]"/>
                <field name="matricule_institutionnel"/>
                <field name="nom_arabe"/>
            </field>
        </field>
    </record>

    <record id="action_his_person" model="ir.actions.act_window">
        <field name="name">People</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <!-- Holding a card is what makes someone a person here. It matches how
             people actually arrive: one imported row of card number and name. -->
        <field name="domain">[('meal_card_ids', '!=', False)]</field>
        <field name="context">{'default_statut': 'actif'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nobody holds a card yet</p>
            <p>People appear here once they have been given a card. Import them as
               card number and name together, or create the person and tap their
               card on the Cards screen.</p>
        </field>
    </record>

    <record id="view_his_faculty_list" model="ir.ui.view">
        <field name="name">his.faculty.list</field>
        <field name="model">his.faculty</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-warning="not name_confirmed">
                <field name="code"/>
                <field name="name"/>
                <field name="name_confirmed" string="Name confirmed"/>
            </list>
        </field>
    </record>

    <record id="action_his_faculty" model="ir.actions.act_window">
        <field name="name">Faculties</field>
        <field name="res_model">his.faculty</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The faculty referential</p>
            <p>Six codes were observed in the HIS data. A person may belong to more
               than one, which is why the link is many-to-many.</p>
        </field>
    </record>

</odoo>
