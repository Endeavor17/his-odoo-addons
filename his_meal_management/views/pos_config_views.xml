<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_config_form_meal" model="ir.ui.view">
        <field name="name">pos.config.form.meal</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='configuration']//div[hasclass('o_settings_container')]" position="inside">
                <setting string="Student Meal Product"
                         help="The meal a student pays for with one credit. Set it on the restaurant; leave it empty on the point of sale that sells the plans.">
                    <field name="meal_product_id"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
