#. module: his_meal_management
#: model:mail.template,body_html:his_meal_management.mail_template_pos_ticket
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Hello <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"    <p>Here is your ticket <strong t-out=\"object.pos_reference or object.name or ''\"/> from <t t-out=\"object.config_id.name or ''\"/>, <t t-out=\"format_datetime(object.date_order, tz=object.config_id.company_id.partner_id.tz or 'Africa/Algiers')\"/>.</p>\n"
"    <table style=\"border-collapse: collapse; min-width: 320px;\">\n"
"        <t t-foreach=\"object._his_ticket_lines()\" t-as=\"line\">\n"
"            <tr>\n"
"                <td style=\"padding: 4px 8px;\" t-out=\"'%g' % line.qty\"/>\n"
"                <td style=\"padding: 4px 8px;\">\n"
"                    <t t-out=\"line.full_product_name or line.product_id.display_name\"/>\n"
"                    <div t-if=\"line.customer_note\" style=\"color: #6c757d; font-size: 12px;\" t-out=\"line.customer_note\"/>\n"
"                </td>\n"
"                <td style=\"padding: 4px 8px; text-align: right;\" t-out=\"format_amount(line.price_subtotal_incl, object.currency_id)\"/>\n"
"            </tr>\n"
"        </t>\n"
"        <tr>\n"
"            <td/>\n"
"            <td style=\"padding: 4px 8px;\"><strong>Total</strong></td>\n"
"            <td style=\"padding: 4px 8px; text-align: right;\"><strong t-out=\"format_amount(object.amount_total, object.currency_id)\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td/>\n"
"            <td style=\"padding: 4px 8px;\">Including VAT</td>\n"
"            <td style=\"padding: 4px 8px; text-align: right;\" t-out=\"format_amount(object.amount_tax, object.currency_id)\"/>\n"
"        </tr>\n"
"    </table>\n"
"    <p t-if=\"object._his_ticket_credits_left()\">Meal credits left: <strong t-out=\"object._his_ticket_credits_left()\"/></p>\n"
"    <p><t t-out=\"object.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Bonjour <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"    <p>Voici votre ticket <strong t-out=\"object.pos_reference or object.name or ''\"/> de <t t-out=\"object.config_id.name or ''\"/>, <t t-out=\"format_datetime(object.date_order, tz=object.config_id.company_id.partner_id.tz or 'Africa/Algiers')\"/>.</p>\n"
"    <table style=\"border-collapse: collapse; min-width: 320px;\">\n"
"        <t t-foreach=\"object._his_ticket_lines()\" t-as=\"line\">\n"
"            <tr>\n"
"                <td style=\"padding: 4px 8px;\" t-out=\"'%g' % line.qty\"/>\n"
"                <td style=\"padding: 4px 8px;\">\n"
"                    <t t-out=\"line.full_product_name or line.product_id.display_name\"/>\n"
"                    <div t-if=\"line.customer_note\" style=\"color: #6c757d; font-size: 12px;\" t-out=\"line.customer_note\"/>\n"
"                </td>\n"
"                <td style=\"padding: 4px 8px; text-align: right;\" t-out=\"format_amount(line.price_subtotal_incl, object.currency_id)\"/>\n"
"            </tr>\n"
"        </t>\n"
"        <tr>\n"
"            <td/>\n"
"            <td style=\"padding: 4px 8px;\"><strong>Total</strong></td>\n"
"            <td style=\"padding: 4px 8px; text-align: right;\"><strong t-out=\"format_amount(object.amount_total, object.currency_id)\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td/>\n"
"            <td style=\"padding: 4px 8px;\">Dont TVA</td>\n"
"            <td style=\"padding: 4px 8px; text-align: right;\" t-out=\"format_amount(object.amount_tax, object.currency_id)\"/>\n"
"        </tr>\n"
"    </table>\n"
"    <p t-if=\"object._his_ticket_credits_left()\">Crédits repas restants : <strong t-out=\"object._his_ticket_credits_left()\"/></p>\n"
"    <p><t t-out=\"object.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "

