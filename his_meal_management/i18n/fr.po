#. module: his_meal_management
#: model_terms:ir.actions.act_window,help:his_meal_management.action_meal_card
msgid ""
"A card only identifies the person. Blocking or replacing one never\n"
"               touches their meal credits."
msgstr ""
"Une carte ne fait qu'identifier la personne. La bloquer ou la remplacer\n"
"               ne touche jamais à ses crédits repas."

#. module: his_meal_management
#. odoo-python
#: code:addons/his_meal_management/models/product_template.py:0
msgid "A meal cannot cost a negative number of credits."
msgstr "Un repas ne peut pas coûter un nombre négatif de crédits."

#. module: his_meal_management
#. odoo-python
#: code:addons/his_meal_management/models/product_template.py:0
msgid "A meal plan cannot grant a negative number of credits."
msgstr "Un forfait repas ne peut pas accorder un nombre négatif de crédits."

#. module: his_meal_management
#: model_terms:ir.actions.act_window,help:his_meal_management.action_meal_plan
msgid ""
"A plan is an ordinary product that happens to carry meal credits\n"
"               and a validity. Selling it at the point of sale grants the credits."
msgstr ""
"Un forfait est un produit ordinaire qui porte des crédits repas\n"
"               et une validité. Le vendre en caisse accorde les crédits."

#. module: his_meal_management
#: model:ir.model.constraint,message:his_meal_management.constraint_his_meal_subscription_dates_ordered
msgid "A subscription cannot end before it starts."
msgstr "Un abonnement ne peut pas se terminer avant de commencer."

#. module: his_meal_management
#: model:ir.model.constraint,message:his_meal_management.constraint_his_meal_subscription_credits_within_bounds
msgid ""
"A subscription cannot use fewer than zero or more credits than it was sold."
msgstr ""
"Un abonnement ne peut pas consommer moins de zéro crédit, ni plus que ce qui"
" a été vendu."

#. module: his_meal_management
#: model:ir.model.constraint,message:his_meal_management.constraint_his_meal_subscription_credits_total_positive
msgid "A subscription must carry at least one credit."
msgstr "Un abonnement doit porter au moins un crédit."

#. module: his_meal_management
#. odoo-python
#: code:addons/his_meal_management/wizard/meal_adjust_wizard.py:0
msgid "A validity cannot be negative. Use zero for credits that never expire."
msgstr ""
"Une validité ne peut pas être négative. Mettez zéro pour des crédits qui "
"n'expirent jamais."

