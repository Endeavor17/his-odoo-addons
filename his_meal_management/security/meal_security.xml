<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_meal" model="ir.module.category">
        <field name="name">Meal Management</field>
        <field name="description">Student meal cards, plans and credits.</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_meal" model="res.groups.privilege">
        <field name="name">Meal Management</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_meal"/>
    </record>

    <record id="group_meal_cashier" model="res.groups">
        <field name="name">Restaurant Cashier</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_meal"/>
        <field name="comment">Serves meals. Can look up a student and their balance,
            but cannot create, edit or delete cards, subscriptions or ledger lines.
            Credits move only through the point of sale, on the server.</field>
    </record>

    <record id="group_meal_officer" model="res.groups">
        <field name="name">Meal Officer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_meal"/>
        <field name="implied_ids" eval="[(4, ref('group_meal_cashier'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">IT centre staff. Issues and replaces cards, manages plans
            and subscriptions, and posts corrections. Still cannot edit or delete a
            ledger line.</field>
    </record>

    <!-- Audit S-6 : rouvre les etudiants que
         his_person_core.rule_partner_student_candidate_private ferme. Le
         caissier retrouve un etudiant par sa carte ; l'officier en herite. -->
    <record id="rule_partner_all_meal_cashier" model="ir.rule">
        <field name="name">Contacts : tous (restauration)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('group_meal_cashier'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Audit S-6 (sonde P3) : un caissier lisait l'historique de repas de tous
         les etudiants. Il ne lit plus que les lignes qu'il a passees ; le solde
         affiche en caisse vient de get_meal_balance, qui lit en sudo. -->
    <record id="rule_meal_transaction_cashier_own" model="ir.rule">
        <field name="name">Grand livre repas : ses propres lignes (caissier)</field>
        <field name="model_id" ref="model_his_meal_transaction"/>
        <field name="groups" eval="[(4, ref('group_meal_cashier'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_meal_transaction_officer_all" model="ir.rule">
        <field name="name">Grand livre repas : tout (officier)</field>
        <field name="model_id" ref="model_his_meal_transaction"/>
        <field name="groups" eval="[(4, ref('group_meal_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
