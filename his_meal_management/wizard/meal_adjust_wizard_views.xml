<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_meal_adjust_wizard_form" model="ir.ui.view">
        <field name="name">his.meal.adjust.wizard.form</field>
        <field name="model">his.meal.adjust.wizard</field>
        <field name="arch" type="xml">
            <form string="Correct Meal Credits">
                <group>
                    <field name="partner_id"/>
                    <field name="current_credits"/>
                    <field name="credits"/>
                    <field name="validity_days" invisible="credits &lt;= 0"/>
                    <field name="reason" placeholder="e.g. refund for a meal that was never served"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    The correction is written to the ledger under your name. It cannot
                    be undone, only corrected again.
                </div>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_meal_adjust_wizard" model="ir.actions.act_window">
        <field name="name">Correct Credits</field>
        <field name="res_model">his.meal.adjust.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
