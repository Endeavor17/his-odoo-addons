<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="his_meal_management.MealBalance">
        <div class="h-100 overflow-auto bg-view p-4">
            <div class="mx-auto" style="max-width: 760px;">
                <form t-on-submit.prevent="lookup">
                    <input t-ref="search" t-model="state.query" class="form-control form-control-lg"
                           autocomplete="off" placeholder="Scan a card, or type a name or a matricule"/>
                </form>

                <p t-if="state.notFound" class="mt-3 fs-5 text-danger">
                    No student found for "<t t-esc="state.notFound"/>".
                </p>

                <div t-if="state.holders.length" class="list-group mt-3">
                    <button t-foreach="state.holders" t-as="holder" t-key="holder.id" type="button"
                            class="list-group-item list-group-item-action d-flex justify-content-between fs-5"
                            t-on-click="() => this.show(holder.id)">
                        <span t-esc="holder.name"/>
                        <span class="text-muted" t-esc="holder.matricule"/>
                    </button>
                </div>

                <t t-if="state.balance">
                <t t-set="b" t-value="state.balance"/>
                <div class="card mt-4">
                    <div class="card-body p-4">
                        <h2 class="mb-1" t-esc="b.name"/>
                        <div class="fs-5 text-muted" t-esc="b.matricule"/>

                        <t t-if="b.plan">
                            <div class="mt-4 fs-5">Plan: <strong t-esc="b.plan"/></div>
                            <div class="d-flex justify-content-between align-items-end mt-3">
                                <div>
                                    <div class="text-muted">Credits left</div>
                                    <div class="display-3 fw-bold lh-1" t-esc="credits(b.credits)"/>
                                </div>
                                <div class="text-end fs-5">
                                    <div>Used: <strong t-esc="credits(b.credits_used)"/></div>
                                    <div>Total: <strong t-esc="credits(b.credits_total)"/></div>
                                </div>
                            </div>
                            <div class="progress mt-3" style="height: 12px;">
                                <div class="progress-bar" role="progressbar" t-attf-style="width: {{ usedPercent }}%;"/>
                            </div>
                            <div t-if="b.expires" class="mt-2 text-muted">Valid until <t t-esc="expires"/></div>
                        </t>
                        <div t-else="" class="mt-4 fs-4 text-muted">No active meal plan.</div>

                        <div t-if="b.allowance_debt" class="alert alert-warning mt-3 mb-0">
                            Owes <t t-esc="credits(b.allowance_debt)"/> credit(s) for meals served on allowance.
                        </div>
                        <div t-elif="!b.credits and b.allowance_left" class="alert alert-info mt-3 mb-0">
                            <t t-esc="b.allowance_left"/> allowance meal(s) left before the card is refused.
                        </div>
                    </div>
                </div>
                </t>
            </div>
        </div>
    </t>

    <!-- The desk's way in: a card under the registers on the Point of Sale
         dashboard. It opens the screen by its tag rather than by an action
         record, so it works as soon as the code is deployed, before anyone
         runs the module upgrade. -->
    <t t-name="his_meal_management.PosKanbanRenderer" t-inherit="point_of_sale.PosKanbanRenderer" t-inherit-mode="extension">
        <xpath expr="//t[@t-call='web.KanbanRenderer']" position="after">
            <div class="px-3 pb-3">
                <div class="card" style="max-width: 616px;">
                    <div class="card-body d-flex align-items-center justify-content-between gap-3">
                        <div>
                            <h5 class="card-title">Meal Balance</h5>
                            <p class="card-text text-muted mb-0">Scan a student card to see the plan and the credits used and left.</p>
                        </div>
                        <button class="btn btn-primary" t-on-click="() => action.doAction({ type: 'ir.actions.client', tag: 'his_meal_balance', name: 'Meal Balance' })">
                            Open
                        </button>
                    </div>
                </div>
            </div>
        </xpath>
    </t>

</templates>
