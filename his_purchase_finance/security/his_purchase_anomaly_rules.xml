<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Achats et Finance voient toutes les anomalies ; le magasinier celles des
         receptions et les siennes ; le demandeur les siennes. -->
    <record id="rule_anomaly_purchase" model="ir.rule">
        <field name="name">Purchase anomaly: purchasing and Finance</field>
        <field name="model_id" ref="model_his_purchase_anomaly"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <record id="rule_anomaly_stock" model="ir.rule">
        <field name="name">Purchase anomaly: receipts and own</field>
        <field name="model_id" ref="model_his_purchase_anomaly"/>
        <field name="domain_force">['|', ('declared_by_id', '=', user.id), ('picking_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="rule_anomaly_requester" model="ir.rule">
        <field name="name">Purchase anomaly: own</field>
        <field name="model_id" ref="model_his_purchase_anomaly"/>
        <field name="domain_force">[('declared_by_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('his_purchase.group_requester'))]"/>
    </record>
</odoo>
