#. module: his_helpdesk_identity_bridge
#: model:mail.template,body_html:his_helpdesk_identity_bridge.mail_template_accuse_reception
msgid ""
"<div>\n"
"    <p>Hello<t t-if=\"object.partner_id.name or object.partner_name\"> <t t-out=\"object.partner_id.name or object.partner_name\"/></t>,</p>\n"
"    <p>We have received your request <strong><t t-out=\"object.number\"/></strong> (\"<t t-out=\"object.name\"/>\").</p>\n"
"    <p>Our team is looking into it and will get back to you as soon as possible.</p>\n"
"    <p>To add information, simply reply to this message: your reply will be added to your request.</p>\n"
"</div>\n"
"        "
msgstr ""
"<div dir=\"rtl\">\n"
"    <p>مرحبًا<t t-if=\"object.partner_id.name or object.partner_name\"> <t t-out=\"object.partner_id.name or object.partner_name\"/></t>،</p>\n"
"    <p>لقد استلمنا طلبكم <strong><t t-out=\"object.number\"/></strong> («<t t-out=\"object.name\"/>»).</p>\n"
"    <p>يقوم فريقنا بدراسته وسنعود إليكم في أقرب وقت ممكن.</p>\n"
"    <p>لإضافة معلومات، يكفي الرد على هذه الرسالة: سيُضاف ردّكم إلى طلبكم.</p>\n"
"</div>\n"
"        "

#. module: his_helpdesk_identity_bridge
#: model:mail.template,name:his_helpdesk_identity_bridge.mail_template_accuse_reception
