msgstr "مكتب المساعدة: إشعار بالاستلام"

#. module: his_helpdesk_identity_bridge
#: model:mail.template,subject:his_helpdesk_identity_bridge.mail_template_accuse_reception
msgid "Your request {{ object.number }} has been received: {{ object.name }}"
msgstr "تم استلام طلبكم {{ object.number }}: {{ object.name }}"
