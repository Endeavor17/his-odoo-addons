<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Accuse de reception d'un ticket, envoye a la creation (courriel ou
         formulaire) par helpdesk.ticket.create, seulement si le ticket a un
         email client. Toujours depuis odoo-support@, jamais l'adresse de
         l'agent ou du caissier. Source anglaise, francais dans i18n/fr.po,
         arabe dans i18n/ar.po ; langue du client, sinon celle de la societe.
         Pas de reply_to : Odoo traiterait alors une reponse comme un nouveau
         courriel (reply_to_force_new) ; sans lui, il prend l'adresse de
         reponse du ticket. auto_delete False : le message reste sur le
         ticket, une reponse y retrouve son fil au lieu d'ouvrir un ticket. -->
    <record id="mail_template_accuse_reception" model="mail.template">
        <field name="name">Helpdesk: acknowledgement of receipt</field>
        <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
        <field name="subject">Your request {{ object.number }} has been received: {{ object.name }}</field>
        <field name="email_from">{{ object.company_id.alias_domain_id and 'odoo-support@' + object.company_id.alias_domain_id.name or object.company_id.email_formatted }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="email_to">{{ object.partner_email or object.partner_id.email or '' }}</field>
        <field name="lang">{{ object.partner_id.lang or object.company_id.partner_id.lang }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
<div>
    <p>Hello<t t-if="object.partner_id.name or object.partner_name"> <t t-out="object.partner_id.name or object.partner_name"/></t>,</p>
    <p>We have received your request <strong><t t-out="object.number"/></strong> ("<t t-out="object.name"/>").</p>
    <p>Our team is looking into it and will get back to you as soon as possible.</p>
    <p>To add information, simply reply to this message: your reply will be added to your request.</p>
</div>
        </field>
    </record>
</odoo>
