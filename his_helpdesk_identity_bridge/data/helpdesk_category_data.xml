<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Premier jet de categories (demande par Mohamed le 2026-10-18, a
         corriger a l'usage). Une seule equipe : le service concerne est la
         categorie parente, le ticket affiche « Informatique / Wi-Fi ».
         noupdate : un renommage ou un archivage fait dans la configuration
         survit aux mises a jour. -->
    <data noupdate="1">
        <record id="categ_it" model="helpdesk.ticket.category">
            <field name="name">IT</field>
            <field name="sequence">10</field>
        </record>
        <record id="categ_it_compte" model="helpdesk.ticket.category">
            <field name="name">Account &amp; Password</field>
            <field name="parent_id" ref="categ_it"/>
            <field name="sequence">11</field>
        </record>
        <record id="categ_it_courriel" model="helpdesk.ticket.category">
            <field name="name">Email</field>
            <field name="parent_id" ref="categ_it"/>
            <field name="sequence">12</field>
        </record>
        <record id="categ_it_reseau" model="helpdesk.ticket.category">
            <field name="name">Wi-Fi &amp; Network</field>
            <field name="parent_id" ref="categ_it"/>
            <field name="sequence">13</field>
        </record>
        <record id="categ_it_materiel" model="helpdesk.ticket.category">
            <field name="name">Computer &amp; Printer</field>
            <field name="parent_id" ref="categ_it"/>
            <field name="sequence">14</field>
        </record>
        <record id="categ_it_logiciel" model="helpdesk.ticket.category">
            <field name="name">Software &amp; Online Platforms</field>
            <field name="parent_id" ref="categ_it"/>
            <field name="sequence">15</field>
        </record>

        <record id="categ_scol" model="helpdesk.ticket.category">
            <field name="name">Registrar</field>
            <field name="sequence">20</field>
        </record>
        <record id="categ_scol_attestation" model="helpdesk.ticket.category">
            <field name="name">Enrolment Certificate</field>
            <field name="parent_id" ref="categ_scol"/>
            <field name="sequence">21</field>
        </record>
        <record id="categ_scol_notes" model="helpdesk.ticket.category">
            <field name="name">Grades &amp; Transcripts</field>
            <field name="parent_id" ref="categ_scol"/>
            <field name="sequence">22</field>
        </record>
        <record id="categ_scol_emploi_du_temps" model="helpdesk.ticket.category">
            <field name="name">Timetable &amp; Exams</field>
            <field name="parent_id" ref="categ_scol"/>
            <field name="sequence">23</field>
        </record>
        <record id="categ_scol_carte" model="helpdesk.ticket.category">
            <field name="name">Student Card</field>
            <field name="parent_id" ref="categ_scol"/>
            <field name="sequence">24</field>
        </record>
        <record id="categ_scol_dossier" model="helpdesk.ticket.category">
            <field name="name">Personal Details Change</field>
            <field name="parent_id" ref="categ_scol"/>
            <field name="sequence">25</field>
        </record>

        <record id="categ_adm" model="helpdesk.ticket.category">
            <field name="name">Admissions</field>
            <field name="sequence">30</field>
        </record>
        <record id="categ_adm_candidature" model="helpdesk.ticket.category">
            <field name="name">Application Follow-up</field>
            <field name="parent_id" ref="categ_adm"/>
            <field name="sequence">31</field>
        </record>
        <record id="categ_adm_pieces" model="helpdesk.ticket.category">
            <field name="name">Missing Documents</field>
            <field name="parent_id" ref="categ_adm"/>
            <field name="sequence">32</field>
        </record>
        <record id="categ_adm_inscription" model="helpdesk.ticket.category">
            <field name="name">Registration</field>
            <field name="parent_id" ref="categ_adm"/>
            <field name="sequence">33</field>
        </record>

        <record id="categ_fin" model="helpdesk.ticket.category">
            <field name="name">Finance / Cashier</field>
            <field name="sequence">40</field>
        </record>
        <record id="categ_fin_frais" model="helpdesk.ticket.category">
            <field name="name">Tuition Fees &amp; Payment</field>
            <field name="parent_id" ref="categ_fin"/>
            <field name="sequence">41</field>
        </record>
        <record id="categ_fin_recu" model="helpdesk.ticket.category">
            <field name="name">Receipt</field>
            <field name="parent_id" ref="categ_fin"/>
            <field name="sequence">42</field>
        </record>
        <record id="categ_fin_repas" model="helpdesk.ticket.category">
            <field name="name">Meal Credits</field>
            <field name="parent_id" ref="categ_fin"/>
            <field name="sequence">43</field>
        </record>
        <record id="categ_fin_remboursement" model="helpdesk.ticket.category">
            <field name="name">Refund</field>
            <field name="parent_id" ref="categ_fin"/>
            <field name="sequence">44</field>
        </record>

        <record id="categ_autre" model="helpdesk.ticket.category">
            <field name="name">Other</field>
            <field name="sequence">99</field>
        </record>
    </data>

    <!-- Seul le personnel ouvre des tickets : aucun ne vient du web. A
         l'installation seulement (noupdate chez OCA) ; une base deja
         installee passe par la migration 19.0.1.1.0. -->
    <data>
        <record id="helpdesk_mgmt.helpdesk_ticket_channel_web" model="helpdesk.ticket.channel">
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
