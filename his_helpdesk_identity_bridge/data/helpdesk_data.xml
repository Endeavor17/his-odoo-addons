<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Une seule equipe : HIS a un agent de support, qui traite tout
             sans transmettre (Mohamed, 2026-10-18). Elle remplace les quatre
             equipes du 2026-10-07 ; le service concerne passe dans la
             categorie. Ses membres suivent le poste « Support Officer »,
             qui donne aussi le role Helpdesk Manager. -->
        <record id="job_support" model="hr.job">
            <field name="name">Support Officer</field>
            <field name="group_ids" eval="[Command.link(ref('helpdesk_mgmt.group_helpdesk_manager'))]"/>
        </record>
        <record id="team_support" model="helpdesk.ticket.team">
            <field name="name">Support</field>
            <field name="his_job_id" ref="job_support"/>
        </record>

        <!-- Le personnel ouvre des tickets pour un etudiant venu au guichet. -->
        <record id="channel_guichet" model="helpdesk.ticket.channel">
            <field name="name">Front Desk</field>
        </record>

        <!-- Adresse publique du helpdesk : odoo-support@his.edu.dz (OCA la nomme
             help). Le courriel devient un ticket de l'equipe Support. -->
        <record id="helpdesk_mgmt.mail_alias_lead_info_helpdesk" model="mail.alias">
            <field name="alias_name">odoo-support</field>
        </record>

        <!-- Les reponses arrivent dans Odoo (catchall@ redirige vers test-support@, releve en IMAP) et
             rejoignent le ticket. Copie a l'adresse d'ou l'etudiant a ecrit
             quand elle differe de celle de sa fiche : c'est la qu'il lit. -->
        <record id="helpdesk_mgmt.closed_ticket_template" model="mail.template">
            <!-- Sans cela Odoo ignore partner_to / email_cc et n'ecrit qu'au contact. -->
            <field name="use_default_to" eval="False"/>
            <field name="email_cc">{{object.partner_email if object.partner_email and object.partner_email != object.partner_id.email else ''}}</field>
            <field name="subject">Votre demande {{object.number}} est clôturée</field>
            <field name="body_html" type="html">
                <p>Bonjour <t t-out="object.partner_id.name or object.partner_name or ''"/>,</p>
                <p>Votre demande <strong><t t-out="object.number"/></strong>
                   (« <t t-out="object.name"/> ») est clôturée.</p>
                <p>Pour toute question, vous pouvez répondre à ce message :
                   votre réponse sera ajoutée à votre demande.</p>
            </field>
        </record>

    </data>
</odoo>
