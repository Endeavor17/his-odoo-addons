<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cadence HORAIRE, pas quotidienne. Le SLA porte sur 4 heures : un
             cron journalier signalerait un retard le lendemain, quand la
             relance n'a plus d'objet. Le defaut d'Odoo (1 day) est donc
             explicitement ecrase ici. -->
        <record id="ir_cron_his_crm_sla_premier_contact" model="ir.cron">
            <field name="name">CRM Admissions : relance SLA premier contact</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_relance_sla_premier_contact()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>

    </data>
</odoo>
