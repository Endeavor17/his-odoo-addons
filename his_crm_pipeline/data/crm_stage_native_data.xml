<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- LE defaut qui melangeait les deux pipelines.

             crm.lead.stage_id porte le domaine natif :
                 ['|', ('team_ids', '=', False), ('team_ids', 'in', team_id)]

             Une etape SANS equipe apparait donc dans TOUS les pipelines. Odoo
             livre quatre etapes sans equipe — New, Qualified, Proposition,
             Won — qui se retrouvaient melees aux etapes Admissions comme aux
             etapes Production Contenu, sur la meme barre d'etat.

             On les rattache a l'equipe « Sales » que le noyau cree lui-meme.
             Elles gardent un pipeline coherent la ou Odoo les attend, et
             disparaissent des deux notres — personne chez nous n'est membre de
             cette equipe.

             Pourquoi pas les supprimer : crm.lead.stage_id est en
             ondelete='restrict'. Un seul lead posé dessus, et la
             desinstallation ou la mise a jour casse. Les deplacer est
             reversible, les supprimer ne l'est pas. -->

        <record id="crm.stage_lead1" model="crm.stage">
            <field name="team_ids" eval="[(4, ref('sales_team.team_sales_department'))]"/>
        </record>
        <record id="crm.stage_lead2" model="crm.stage">
            <field name="team_ids" eval="[(4, ref('sales_team.team_sales_department'))]"/>
        </record>
        <record id="crm.stage_lead3" model="crm.stage">
            <field name="team_ids" eval="[(4, ref('sales_team.team_sales_department'))]"/>
        </record>
        <record id="crm.stage_lead4" model="crm.stage">
            <field name="team_ids" eval="[(4, ref('sales_team.team_sales_department'))]"/>
        </record>

    </data>
</odoo>
