<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1" : les trois types de depart. L'equipe Contenu doit pouvoir
         les renommer, en desactiver un ou en ajouter — podcast, affiche —
         sans qu'une livraison ecrase son travail. Meme choix que pour les
         etapes et les types de piece. -->
    <data noupdate="1">

        <record id="deliverable_type_copy" model="his.content.deliverable.type">
            <field name="name">Copywriting</field>
            <field name="code">copy</field>
            <field name="sequence">10</field>
        </record>

        <record id="deliverable_type_design" model="his.content.deliverable.type">
            <field name="name">Design</field>
            <field name="code">design</field>
            <field name="sequence">20</field>
        </record>

        <record id="deliverable_type_video" model="his.content.deliverable.type">
            <field name="name">Video</field>
            <field name="code">video</field>
            <field name="sequence">30</field>
        </record>

    </data>
</odoo>
