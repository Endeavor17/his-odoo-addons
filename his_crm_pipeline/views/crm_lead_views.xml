<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= Formulaire : deux blocs, une equipe ================= -->

    <record id="view_crm_lead_form_his" model="ir.ui.view">
        <field name="name">crm.lead.form.his</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">

                <!-- Les deux blocs s'excluent par l'equipe. Un lead d'admission
                     n'a rien a faire d'un statut video, et l'inverse. -->
                <page string="Admissions" name="his_admissions"
                      invisible="team_id != %(his_crm_pipeline.crm_team_ventes)d and team_id != %(his_crm_pipeline.crm_team_orientation)d">
                    <group>
                        <group string="Scoring">
                            <field name="score_academique"/>
                            <field name="score_opportunite"/>
                        </group>
                        <group string="Visite du campus">
                            <field name="visite_campus_effectuee"/>
                            <field name="date_visite_campus"
                                   invisible="not visite_campus_effectuee"/>
                            <!-- Programmer et constater sont deux gestes
                                 distincts, et ils le restent.

                                 action_schedule_meeting est native (crm) :
                                 elle ouvre l'agenda pre-rempli du candidat et
                                 de l'equipe. Elle ne coche RIEN — la case
                                 ci-dessus reste ce qu'une conseillere atteste
                                 apres coup. Un rendez-vous pris n'est pas une
                                 visite effectuee : les absences sont
                                 courantes, et un booleen qui deviendrait vrai
                                 tout seul mentirait sur la moitie d'entre
                                 elles. -->
                            <button name="action_schedule_meeting" type="object"
                                    string="Programmer une visite"
                                    icon="fa-calendar-plus-o" class="btn-link"/>
                        </group>
                    </group>
                    <group>
                        <group string="Joindre le candidat">
                            <field name="tentatives_appel"/>
                            <field name="derniere_tentative"
                                   invisible="not tentatives_appel"/>
                            <field name="telephone_e164"/>
                            <!-- Le lien WhatsApp plutot qu'un bouton : c'est un
                                 lien profond vers une application externe, pas
                                 une action serveur. Le widget url le dit. -->
                            <field name="whatsapp_url" widget="url"
                                   text="Ouvrir WhatsApp"
                                   invisible="not whatsapp_url"/>
                        </group>
                        <group string="Issue de l'appel">
                            <button name="action_appel_sans_reponse"
                                    type="object" class="btn-secondary"
                                    string="Sans reponse"/>
                            <button name="action_appel_joint"
                                    type="object" class="btn-primary"
                                    string="Joint"/>
                        </group>
                    </group>
                    <group string="Motivation">
                        <field name="motivation_notes" nolabel="1"
                               placeholder="Ce que le candidat dit de son projet..."/>
                    </group>
                </page>

                <page string="Production contenu" name="his_contenu"
                      invisible="team_id != %(his_crm_pipeline.crm_team_contenu)d">
                    <group>
                        <group string="Demande">
                            <field name="demandeur_id" readonly="1"/>
                            <field name="departement_demandeur"/>
                            <field name="marque"/>
                        </group>
                    </group>
                    <!-- Une ligne par livrable demande : ils avancent
                         independamment. Une ligne n'existe que si le livrable
                         est demande — c'est ce qui distingue « pas encore
                         fait » de « pas concerne ». -->
                    <field name="deliverable_ids" nolabel="1"
                           context="{'default_statut': 'a_faire'}">
                        <list editable="bottom" string="Livrables"
                              decoration-danger="en_retard"
                              decoration-muted="statut == 'approuve'">
                            <field name="type_id"/>
                            <field name="assignee_id"/>
                            <field name="statut"/>
                            <field name="date_echeance" optional="show"/>
                            <field name="date_fin" optional="hide"/>
                            <field name="en_retard" column_invisible="1"/>
                        </list>
                    </field>
                </page>

            </notebook>
        </field>
    </record>

    <!-- ================= File d'affectation (responsable) ================= -->

    <record id="view_crm_lead_list_non_affectes" model="ir.ui.view">
        <field name="name">crm.lead.list.non.affectes</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <!-- multi_edit : c'est tout le mecanisme d'affectation en masse.
                 Le responsable coche plusieurs lignes, edite « Commercial » sur
                 l'une d'elles, Odoo propage. Aucune logique cote serveur, aucun
                 round-robin : l'affectation est un arbitrage humain, voulu tel
                 quel par la Direction. -->
            <list string="Leads a affecter" multi_edit="1" default_order="score_academique desc">
                <field name="score_academique"/>
                <field name="name"/>
                <field name="partner_name" optional="show"/>
                <field name="email_from" optional="show"/>
                <field name="phone" optional="hide"/>
                <field name="stage_id"/>
                <field name="create_date" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="team_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_crm_lead_non_affectes" model="ir.actions.act_window">
        <field name="name">Leads a affecter</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_crm_lead_list_non_affectes"/>
        <field name="domain" eval="[('user_id', '=', False), ('stage_id', 'in', [ref('his_crm_pipeline.stage_vente_nouveau'), ref('his_crm_pipeline.stage_vente_pris_en_charge')])]"/>
        <field name="context" eval="{'default_team_id': ref('his_crm_pipeline.crm_team_ventes')}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun lead en attente d'affectation.</p>
            <p>Les leads scores par le Marketing apparaissent ici, du meilleur score au moins bon.
               Selectionnez-en plusieurs et modifiez le commercial pour les affecter d'un coup.</p>
        </field>
    </record>

    <!-- ============ Boutons de cloture, par role ============

         Les boutons « Gagne » et « Perdu » du formulaire natif ne portent
         aucun groupe : Odoo les montre a quiconque peut ecrire sur le lead.
         C'est ainsi qu'un graphiste pouvait clore une demande de contenu.

         Les masquer ne suffit pas — le kanban, l'import et l'API les
         contournent. La regle tient dans models/crm_capacites.py ; ce qui suit
         ne fait que retirer de l'ecran un geste que le serveur refusera de
         toute facon. -->
    <record id="view_crm_lead_form_cloture" model="ir.ui.view">
        <field name="name">crm.lead.form.cloture.par.role</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <button name="action_set_won_rainbowman" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager,his_crm_pipeline.group_admissions_conseiller,his_crm_pipeline.group_contenu_approbation</attribute>
            </button>
            <xpath expr="//header/button[@name='%(crm.crm_lead_lost_action)d']" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager,his_crm_pipeline.group_admissions_conseiller,his_crm_pipeline.group_contenu_approbation</attribute>
            </xpath>
        </field>
    </record>

    <!-- ==================== Les deux tableaux kanban ====================

         DEUX vues et non une seule partagee, pour une raison technique dont
         decoule tout le reste : <progressbar> est un element de la vue, pas de
         la carte. Il ne porte pas d'attribut `invisible`, donc il ne peut pas
         apparaitre pour une equipe et disparaitre pour l'autre comme le font
         les pages du formulaire. Une vue par pipeline est le seul moyen de
         donner a chacun ce qui a du sens chez lui.

         C'est aussi ce que fait Odoo lui-meme : crm_lead_view_kanban_forecast
         herite de la meme vue stock en mode="primary" pour devenir une vue a
         part entiere. Chaque action pointe la sienne par view_id, exactement
         comme action_crm_lead_non_affectes pointe deja sa liste.

         priority=32 : au-dessus de la vue stock (1), pour qu'aucune de ces deux
         vues ne soit choisie par defaut ailleurs dans Odoo. Elles ne sont
         atteintes que par le view_id de leur action.

         Ce qui n'est PAS redefini ici, deliberement : les etiquettes
         (many2many_tags), l'avatar du commercial (many2one_avatar_user), les
         activites (kanban_activity), la priorite et le pourrissement. La carte
         stock les rend deja. Les redeclarer serait du code mort a maintenir. -->

    <record id="view_crm_lead_kanban_admissions" model="ir.ui.view">
        <field name="name">crm.lead.kanban.admissions</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="mode">primary</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">

            <!-- Le total de colonne. Odoo somme le chiffre d'affaires attendu ;
                 nous n'en avons pas — l'argent d'une candidature vit sur
                 his.engagement, pas ici. Le score est la vraie monnaie de ce
                 pipeline : c'est deja lui qui ordonne la file d'affectation.

                 A NE PAS LIRE COMME UNE VALEUR MONETAIRE. C'est une somme de
                 scores, utile pour comparer deux colonnes entre elles, pas pour
                 annoncer un chiffre d'affaires.

                 `field` reste activity_state : il vient de mail.activity.mixin
                 sans rien coder, et c'est le meme signal que la relance SLA
                 horaire. Une colonne rouge ici veut dire exactement ce que dit
                 l'activite posee sur le responsable. -->
            <xpath expr="//progressbar" position="attributes">
                <attribute name="sum_field">score_academique</attribute>
            </xpath>

            <xpath expr="//kanban" position="inside">
                <field name="visite_campus_effectuee"/>
                <field name="tentatives_appel"/>
                <field name="telephone_e164"/>
                <field name="whatsapp_url"/>
            </xpath>

            <!-- Le geste de la conseillere, la ou elle regarde deja. -->
            <xpath expr="//t[@t-name='menu']" position="inside">
                <a role="menuitem" type="object" name="action_schedule_meeting"
                   class="dropdown-item">Programmer une visite</a>
            </xpath>

            <!-- o_his_lead_kanban_meta est un point d'accroche stable pour les
                 modules en aval : his_admission y ajoute la specialite. Sans
                 classe nommee, ils devraient viser une classe utilitaire
                 Bootstrap (« gap-1 »), qui ne dit rien et changerait au premier
                 ajustement de mise en page. -->
            <xpath expr="//div[hasclass('o_kanban_card_crm_lead_revenue')]" position="replace">
                <div class="o_his_lead_kanban_meta d-flex align-items-center gap-1">
                    <span class="badge rounded-pill text-bg-light"
                          invisible="not score_academique"
                          title="Score academique">
                        <i class="fa fa-star-o me-1" role="img" aria-label="Score academique"/><field name="score_academique"/>
                    </span>
                    <!-- Le compteur ne s'affiche qu'a partir de la premiere
                         tentative : « 0 tentative » est le cas de tout lead
                         neuf et n'apprend rien. A partir de trois, il vire au
                         rouge — c'est le seuil de la candidature fantome. -->
                    <span class="badge rounded-pill"
                          invisible="not tentatives_appel"
                          t-att-class="record.tentatives_appel.raw_value >= 3 ? 'text-bg-danger' : 'text-bg-light'"
                          title="Appels restes sans reponse">
                        <i class="fa fa-phone me-1" role="img" aria-label="Tentatives d'appel"/><field name="tentatives_appel"/>
                    </span>
                    <i class="fa fa-calendar-check-o text-success"
                       role="img" aria-label="Visite du campus effectuee"
                       title="Visite du campus effectuee"
                       invisible="not visite_campus_effectuee"/>
                </div>
            </xpath>

            <!-- La rangee d'action : le geste de la conseillere, la ou elle
                 regarde deja. Des <button type="object"> natifs et non un
                 composant OWL maison — la carte stock les gere, et un widget
                 ecrit a la main casserait a la premiere refonte amont.

                 WhatsApp et tel: sont des LIENS PROFONDS, pas une integration.
                 Ils ouvrent l'application avec le numero pret. Aucun message
                 entrant, aucun accuse de reception, aucun fil dans Odoo :
                 Odoo 19 Community n'a ni telephonie, ni SMS gratuit, ni
                 WhatsApp. C'est une perte assumee face a GoHighLevel. -->
            <!-- En DERNIER dans la carte, et non au milieu : c'est la place
                 qu'occupe la rangee d'icones dans GoHighLevel, et la carte se
                 lit alors identite, puis renseignements, puis gestes. Placee
                 apres les badges, elle separait le nom du contact de son
                 propre titre. -->
            <xpath expr="//t[@t-name='card']" position="inside">
                <div class="o_his_lead_actions d-flex align-items-center gap-1 mt-2">
                    <button type="object" name="action_appel_sans_reponse"
                            class="btn btn-sm btn-outline-secondary"
                            title="Appel sans reponse : compte, trace et replanifie">
                        Sans reponse
                    </button>
                    <button type="object" name="action_appel_joint"
                            class="btn btn-sm btn-outline-primary"
                            title="Candidat joint : passe en Contact etabli">
                        Joint
                    </button>
                    <a t-if="record.whatsapp_url.raw_value"
                       t-att-href="record.whatsapp_url.raw_value"
                       target="_blank" rel="noopener" role="button"
                       class="btn btn-sm btn-outline-success"
                       title="Ouvrir WhatsApp avec ce numero"
                       aria-label="Ouvrir WhatsApp">
                        <i class="fa fa-whatsapp" role="img"/>
                    </a>
                    <a t-if="record.telephone_e164.raw_value"
                       t-attf-href="tel:{{ record.telephone_e164.raw_value }}"
                       role="button"
                       class="btn btn-sm btn-outline-secondary"
                       title="Appeler (utile sur mobile)"
                       aria-label="Appeler">
                        <i class="fa fa-phone" role="img"/>
                    </a>
                </div>
            </xpath>

        </field>
    </record>

    <record id="view_crm_lead_kanban_contenu" model="ir.ui.view">
        <field name="name">crm.lead.kanban.contenu</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="mode">primary</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">

            <!-- Aucune barre de progression ici. Elle regroupe les demandes par
                 etat d'activite, or rien dans ce module ne pose d'activite sur
                 une demande de contenu — la relance SLA ne concerne que les
                 Admissions. La barre serait donc uniformement grise : de
                 l'habillage qui ne dit rien. Le compteur par colonne, lui,
                 reste : Odoo le donne sans rien demander. -->
            <xpath expr="//progressbar" position="replace"/>

            <!-- Ni chiffre d'affaires, ni score : une demande de contenu ne se
                 chiffre pas. Ce qu'on veut voir d'un coup d'oeil, c'est pour
                 qui, pour quelle marque, et ou en sont les livrables. -->
            <xpath expr="//div[hasclass('o_kanban_card_crm_lead_revenue')]" position="replace">
                <div class="o_his_lead_kanban_meta d-flex flex-wrap align-items-center gap-1">
                    <span class="badge rounded-pill text-bg-light"
                          invisible="not departement_demandeur">
                        <field name="departement_demandeur"/>
                    </span>
                    <span class="badge rounded-pill text-bg-light"
                          invisible="not marque">
                        <field name="marque"/>
                    </span>
                </div>
                <!-- Une ligne, pas un tableau : l'avancement detaille se lit
                     dans le formulaire. Ici on veut seulement savoir s'il reste
                     du travail et s'il y a du retard. -->
                <div class="text-muted small" invisible="not livrables_resume">
                    <field name="livrables_resume"/>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
