<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================= Admissions =======================
         Reste dans l'application CRM : ce sont de vrais commerciaux, qui
         utilisent aussi le calendrier, les activites et le chatter. -->

    <record id="action_crm_lead_admissions" model="ir.actions.act_window">
        <field name="name">Pipeline Admissions</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <!-- eval et non %(xmlid)d : la substitution %(...)d n'a lieu que dans
             les champs de type xml (les vues). Sur domain et context, qui sont
             de simples char, le texte serait stocke tel quel et le client web
             echouerait a l'evaluer. C'est la forme qu'Odoo utilise lui-meme. -->
        <field name="domain" eval="[('team_id', 'in', [ref('his_crm_pipeline.crm_team_ventes'), ref('his_crm_pipeline.crm_team_orientation')])]"/>
        <field name="context" eval="{'default_team_id': ref('his_crm_pipeline.crm_team_ventes'), 'default_type': 'opportunity'}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune candidature dans votre pipeline.</p>
            <p>Si cette liste est vide alors qu'il existe des candidatures, c'est que vous
               n'etes membre ni de l'equipe Ventes / Admissions ni de la Cellule d'Orientation.</p>
        </field>
    </record>

    <menuitem id="menu_admissions_root" name="Admissions"
              parent="crm.crm_menu_root" sequence="3"
              groups="his_crm_pipeline.group_admissions_acquisition,his_crm_pipeline.group_admissions_orientation"/>

    <menuitem id="menu_admissions_pipeline" name="Pipeline"
              parent="menu_admissions_root"
              action="action_crm_lead_admissions" sequence="10"/>

    <!-- La file d'affectation est l'outil du responsable : c'est lui qui
         arbitre, et lui seul qui peut y ecrire le commercial. La montrer a une
         conseillere lui proposerait un geste que le serveur refusera. -->
    <menuitem id="menu_crm_lead_non_affectes" name="Leads a affecter"
              parent="menu_admissions_root"
              action="action_crm_lead_non_affectes" sequence="20"
              groups="his_crm_pipeline.group_admissions_responsable"/>

    <!-- =================== Production Contenu ===================
         APPLICATION DISTINCTE, hors du CRM.

         Ce n'est pas une preference d'ergonomie. Le menu CRM d'Odoo est ouvert
         aux groupes commerciaux (sales_team.group_sale_salesman) : y loger la
         production de contenu obligeait a donner un groupe commercial a un
         graphiste, donc l'ecriture sur les contacts, la fusion de leads et le
         calendrier commercial par la meme occasion.

         Ici les roles Contenu ne portent aucun groupe commercial. Le module
         apporte ses propres droits sur crm.lead
         (security/ir.model.access.csv) et ses propres regles
         d'enregistrement. Un graphiste n'a donc simplement pas d'application
         CRM. -->

    <record id="action_crm_lead_contenu" model="ir.actions.act_window">
        <field name="name">Demandes de contenu</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="domain" eval="[('team_id', '=', ref('his_crm_pipeline.crm_team_contenu'))]"/>
        <field name="context" eval="{'default_team_id': ref('his_crm_pipeline.crm_team_contenu'), 'default_type': 'opportunity'}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune demande de contenu.</p>
            <p>Deposez une demande : precisez la marque, le departement demandeur et
               les livrables attendus — texte, design, video.</p>
        </field>
    </record>

    <menuitem id="menu_contenu_root" name="Production Contenu"
              sequence="26"
              groups="his_crm_pipeline.group_contenu_demandeur"/>

    <menuitem id="menu_contenu_demandes" name="Demandes"
              parent="menu_contenu_root"
              action="action_crm_lead_contenu" sequence="10"/>

</odoo>
