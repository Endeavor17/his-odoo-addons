msgstr "Relance 48 h envoyée"

#. module: insite_recruitment
#: model:mail.template,body_html:insite_recruitment.mail_template_insite_reminder
msgid ""
"<div style=\"font-family:Figtree,'Segoe UI',Tahoma,Arial,sans-serif;font-size:14px;color:#1A2340;line-height:1.7;\">\n"
"    <p>\n"
"        <t t-out=\"object.person_id.display_name or ''\">Candidate</t> was contacted on\n"
"        <t t-out=\"object.contacted_date or ''\"/> and has not responded within 48 hours.\n"
"    </p>\n"
"    <p>\n"
"        This is a reminder only — the system will <strong>not</strong> automatically\n"
"        move to the next candidate. Decide whether to wait longer or select another\n"
"        candidate for this Need.\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"font-family:Figtree,'Segoe UI',Tahoma,Arial,sans-serif;font-size:14px;color:#1A2340;line-height:1.7;\">\n"
"    <p>\n"
"        <t t-out=\"object.person_id.display_name or ''\">Le candidat</t> a été contacté(e) le\n"
"        <t t-out=\"object.contacted_date or ''\"/> et n'a pas répondu dans les 48 heures.\n"
"    </p>\n"
"    <p>\n"
"        Ceci n'est qu'un rappel — le système ne passera <strong>pas</strong> automatiquement\n"
"        au candidat suivant. Décidez s'il faut attendre encore ou sélectionner un autre\n"
"        candidat pour ce besoin.\n"
"    </p>\n"
"</div>\n"
"            "

#. module: insite_recruitment
#: model:mail.template,body_html:insite_recruitment.mail_template_insite_invitation
msgid ""
"<div style=\"font-family:Figtree,'Segoe UI',Tahoma,Arial,sans-serif;font-size:14px;color:#1A2340;line-height:1.7;\">\n"
"    <p>Dear <t t-out=\"object.person_id.display_name or ''\">Teacher</t>,</p>\n"
"    <p>\n"
"        You are invited to apply to the <strong>InSite</strong> teaching programme.\n"
"        Please reply to this email to confirm your interest.\n"
"    </p>\n"
"    <p>Best regards.</p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"font-family:Figtree,'Segoe UI',Tahoma,Arial,sans-serif;font-size:14px;color:#1A2340;line-height:1.7;\">\n"
"    <p>Bonjour <t t-out=\"object.person_id.display_name or ''\">Enseignant</t>,</p>\n"
"    <p>\n"
"        Vous êtes invité(e) à candidater au programme d'enseignement <strong>InSite</strong>.\n"
"        Merci de répondre à ce courriel pour confirmer votre intérêt.\n"
"    </p>\n"
"    <p>Cordialement.</p>\n"
"</div>\n"
"            "

#. module: insite_recruitment
#: model:mail.template,body_html:insite_recruitment.mail_template_insite_confirmation
msgid ""
"<div style=\"font-family:Figtree,'Segoe UI',Tahoma,Arial,sans-serif;font-size:14px;color:#1A2340;line-height:1.7;\">\n"
"    <p>Dear <t t-out=\"object.person_id.display_name or ''\">Teacher</t>,</p>\n"
"    <p>Thank you for accepting the InSite teaching programme. Here are your meeting details:</p>\n"
"    <p><strong>Date:</strong> <t t-out=\"format_datetime(dt=object.meeting_event_id.start, tz='UTC', dt_format='EEEE, d MMMM y')\">a date</t></p>\n"
"    <p><strong>Time:</strong> <t t-out=\"format_time(time=object.meeting_event_id.start, tz='UTC')\">a time</t> to <t t-out=\"format_time(time=object.meeting_event_id.stop, tz='UTC')\">a time</t></p>\n"
"    <p><strong>Location / Link:</strong> <t t-out=\"object.meeting_event_id.location or ''\">a location</t></p>\n"
"    <p>Best regards.</p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"font-family:Figtree,'Segoe UI',Tahoma,Arial,sans-serif;font-size:14px;color:#1A2340;line-height:1.7;\">\n"
"    <p>Bonjour <t t-out=\"object.person_id.display_name or ''\">Enseignant</t>,</p>\n"
"    <p>Merci d'avoir accepté le programme d'enseignement InSite. Voici les détails de votre rendez-vous :</p>\n"
"    <p><strong>Date :</strong> <t t-out=\"format_datetime(dt=object.meeting_event_id.start, tz='UTC', dt_format='EEEE d MMMM y')\">une date</t></p>\n"
"    <p><strong>Heure :</strong> de <t t-out=\"format_time(time=object.meeting_event_id.start, tz='UTC')\">une heure</t> à <t t-out=\"format_time(time=object.meeting_event_id.stop, tz='UTC')\">une heure</t></p>\n"
"    <p><strong>Lieu / lien :</strong> <t t-out=\"object.meeting_event_id.location or ''\">un lieu</t></p>\n"
"    <p>Cordialement.</p>\n"
"</div>\n"
"            "

