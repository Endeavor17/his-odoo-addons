<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Raw payloads carry personal data — manager-only, same stance Campus+
         already takes on campus.submission. -->
    <record id="rule_insite_submission_manager" model="ir.rule">
        <field name="name">InSite Submission: managers only</field>
        <field name="model_id" ref="model_insite_submission"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('campus_teacher_management.group_campus_manager'))]"/>
    </record>

    <!-- Every row of these models belongs to exactly one InSite process, so
         the rule is simply "can this user view that one process at all" —
         all-or-nothing, no per-record process lookup. -->
    <record id="rule_insite_need_view" model="ir.rule">
        <field name="name">InSite Need: process view permission</field>
        <field name="model_id" ref="model_insite_recruitment_need"/>
        <field name="domain_force">[(1, '=', 1)] if user.env['campus.process.permission'].sudo().search_count([
            ('process_id.code', '=', 'insite_needs'), ('user_id', '=', user.id),
            ('can_view', '=', True), ('active', '=', True),
        ]) else [(0, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('campus_teacher_management.group_campus_recruiter'))]"/>
    </record>

    <record id="rule_insite_candidature_view" model="ir.rule">
        <field name="name">InSite Candidature: process view permission</field>
        <field name="model_id" ref="model_insite_candidature"/>
        <field name="domain_force">[(1, '=', 1)] if user.env['campus.process.permission'].sudo().search_count([
            ('process_id.code', '=', 'insite_candidatures'), ('user_id', '=', user.id),
            ('can_view', '=', True), ('active', '=', True),
        ]) else [(0, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('campus_teacher_management.group_campus_recruiter'))]"/>
    </record>

    <record id="rule_insite_contract_view" model="ir.rule">
        <field name="name">InSite Contract: process view permission</field>
        <field name="model_id" ref="model_insite_contract"/>
        <field name="domain_force">[(1, '=', 1)] if user.env['campus.process.permission'].sudo().search_count([
            ('process_id.code', '=', 'insite_contracts'), ('user_id', '=', user.id),
            ('can_view', '=', True), ('active', '=', True),
        ]) else [(0, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('campus_teacher_management.group_campus_recruiter'))]"/>
    </record>

    <record id="rule_insite_module_sheet_view" model="ir.rule">
        <field name="name">InSite Module Sheet: process view permission</field>
        <field name="model_id" ref="model_insite_module_sheet"/>
        <field name="domain_force">[(1, '=', 1)] if user.env['campus.process.permission'].sudo().search_count([
            ('process_id.code', '=', 'insite_module_preparation'), ('user_id', '=', user.id),
            ('can_view', '=', True), ('active', '=', True),
        ]) else [(0, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('campus_teacher_management.group_campus_recruiter'))]"/>
    </record>

    <!-- academic.engagement is shared by both processes (process field), so
         only 'insite'-tagged rows are gated here; 'campus'-tagged rows (none
         created by this module) pass through untouched. -->
    <record id="rule_insite_engagement_view" model="ir.rule">
        <field name="name">InSite Engagement: process view permission</field>
        <field name="model_id" ref="model_academic_engagement"/>
        <field name="domain_force">['|', ('process', '!=', 'insite'), (1, '=', 1)] if user.env['campus.process.permission'].sudo().search_count([
            ('process_id.code', '=', 'insite_engagements'), ('user_id', '=', user.id),
            ('can_view', '=', True), ('active', '=', True),
        ]) else [('process', '!=', 'insite')]</field>
        <field name="groups" eval="[(4, ref('campus_teacher_management.group_campus_recruiter'))]"/>
    </record>

</odoo>
