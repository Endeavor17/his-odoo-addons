<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="insite_academic_engagement_view_list" model="ir.ui.view">
        <field name="name">academic.engagement.list.insite</field>
        <field name="model">academic.engagement</field>
        <field name="arch" type="xml">
            <list string="Engagements">
                <field name="person_id"/>
                <field name="module_id"/>
                <field name="academic_period_id"/>
                <field name="process" optional="hide"/>
                <field name="track"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('active', 'completed')"
                       decoration-muted="state in ('draft', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="insite_academic_engagement_view_form" model="ir.ui.view">
        <field name="name">academic.engagement.form.insite</field>
        <field name="model">academic.engagement</field>
        <field name="arch" type="xml">
            <form string="Engagement">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="state != 'draft'"/>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_complete" type="object" string="Complete"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,active,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="person_id" options="{'no_create_edit': True}"/>
                            <field name="module_id"/>
                            <field name="academic_period_id"/>
                        </group>
                        <group>
                            <field name="process"/>
                            <field name="track"/>
                            <field name="need_id" readonly="1"/>
                            <field name="hourly_volume" readonly="1"/>
                            <field name="insite_candidature_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="insite_academic_engagement_view_search" model="ir.ui.view">
        <field name="name">academic.engagement.search.insite</field>
        <field name="model">academic.engagement</field>
        <field name="arch" type="xml">
            <search>
                <field name="person_id"/>
                <field name="module_id"/>
                <field name="academic_period_id"/>
                <field name="insite_candidature_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="active_state" string="Active" domain="[('state', '=', 'active')]"/>
                <group>
                    <filter name="group_period" string="Academic Period" context="{'group_by': 'academic_period_id'}"/>
                    <filter name="group_module" string="Module" context="{'group_by': 'module_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Every engagement InSite creates is process='insite'; the menu both
         filters to that (so it never shows a future Campus+ engagement) and
         defaults new records to it, without a second Engagement model. -->
    <record id="insite_action_engagement" model="ir.actions.act_window">
        <field name="name">Engagements</field>
        <field name="res_model">academic.engagement</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('process', '=', 'insite')]</field>
        <field name="context">{'default_process': 'insite'}</field>
        <field name="view_id" ref="insite_academic_engagement_view_list"/>
        <field name="search_view_id" ref="insite_academic_engagement_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No InSite engagements yet</p>
            <p>Created once a candidature is accepted and assigned to a Module for an Academic Period.</p>
        </field>
    </record>

</odoo>
