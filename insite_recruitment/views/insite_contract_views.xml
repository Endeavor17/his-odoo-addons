<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="insite_contract_view_list" model="ir.ui.view">
        <field name="name">insite.contract.list</field>
        <field name="model">insite.contract</field>
        <field name="arch" type="xml">
            <list string="InSite Contracts">
                <field name="person_id"/>
                <field name="need_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'signed'"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state in ('sent', 'accepted')"
                       decoration-muted="state in ('draft', 'prepared')"/>
                <field name="contract_date"/>
                <field name="signature_date"/>
            </list>
        </field>
    </record>

    <record id="insite_contract_view_form" model="ir.ui.view">
        <field name="name">insite.contract.form</field>
        <field name="model">insite.contract</field>
        <field name="arch" type="xml">
            <form string="InSite Contract">
                <header>
                    <button name="action_prepare" type="object" string="Prepare"
                            invisible="state != 'draft'"/>
                    <button name="action_send" type="object" string="Send"
                            invisible="state != 'prepared'"/>
                    <button name="action_candidate_accept" type="object" string="Candidate Accepted"
                            class="btn-primary" invisible="state != 'sent'"/>
                    <button name="action_candidate_reject" type="object" string="Candidate Rejected"
                            invisible="state not in ('sent', 'accepted')"
                            confirm="Reject this contract? Recruitment stops here for this candidate."/>
                    <button name="action_sign" type="object" string="Mark Signed"
                            class="btn-primary" invisible="state != 'accepted'"
                            confirm="Mark this contract as signed? The signature itself is performed by the human, not the system."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,prepared,sent,accepted,signed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="person_id" options="{'no_create_edit': True}"/>
                            <field name="need_id"/>
                            <field name="candidature_id" readonly="1"/>
                            <field name="engagement_id" readonly="1" invisible="not engagement_id"/>
                        </group>
                        <group>
                            <field name="contract_date"/>
                            <field name="signature_date" readonly="1"/>
                            <field name="document" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="insite_contract_view_search" model="ir.ui.view">
        <field name="name">insite.contract.search</field>
        <field name="model">insite.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="person_id"/>
                <field name="need_id"/>
                <field name="candidature_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="signed" string="Signed" domain="[('state', '=', 'signed')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="insite_action_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">insite.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No InSite contracts yet</p>
            <p>Created once a candidate accepts, before any Engagement exists — Module
               Assignment happens after signature and integration.</p>
        </field>
    </record>

</odoo>
