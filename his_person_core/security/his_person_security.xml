<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_his_person" model="ir.module.category">
            <field name="name">Identite Groupe</field>
            <field name="description">Referentiel des personnes et matricule institutionnel.</field>
            <field name="sequence">20</field>
        </record>

        <record id="res_groups_privilege_his_person" model="res.groups.privilege">
            <field name="name">Identite Groupe</field>
            <field name="category_id" ref="module_category_his_person"/>
        </record>

        <!-- Groupe de gestion. Deliberement etroit : creer une fiche personne,
             c'est emettre un matricule a vie, sur lequel s'appuieront la carte
             RFID et le portefeuille. Les modules qui doivent en creer (ex.
             his_hr_base a l'embauche) le font en sudo() depuis leur logique
             serveur, pas en donnant ce groupe a tout le monde. -->
        <record id="group_his_person_manager" model="res.groups">
            <field name="name">Gestionnaire des personnes</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_his_person"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>

    <!-- Audit S-6. Core lets every internal user read every res.partner, and a
         his.person delegates to a real one: a cook read a candidate's email
         and phone. Students and candidates are closed to base.group_user.

         Group rules OR together, so each role that has business with these
         people re-opens them with its own (1, '=', 1) rule, declared by the
         module that owns the role (his_meal_management, his_hr_base,
         his_pos_partner_scope, his_crm_identity_bridge, his_admission,
         his_access_base). A role missing from that list gets a blank where a
         student's name should be: add a rule there, never widen this one. -->
    <data noupdate="0">

        <record id="rule_partner_student_candidate_private" model="ir.rule">
            <field name="name">Contacts : etudiants et candidats reserves aux roles metier</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', '|',
                ('his_person_ids', '=', False),
                ('his_person_ids.type_personne', 'not in', ['etudiant', 'candidat']),
                ('id', '=', user.partner_id.id)]</field>
        </record>

        <record id="rule_partner_all_person_manager" model="ir.rule">
            <field name="name">Contacts : tous (gestionnaire des personnes, administrateur)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('group_his_person_manager')), (4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
