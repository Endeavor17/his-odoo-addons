<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_maintenance_university" model="ir.module.category">
        <field name="name">University Maintenance</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_maintenance_university" model="res.groups.privilege">
        <field name="name">University Maintenance</field>
        <field name="category_id" ref="module_category_maintenance_university"/>
    </record>

    <record id="group_maintenance_worker" model="res.groups">
        <field name="name">Worker</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_maintenance_university"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_maintenance_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_maintenance_university"/>
        <field name="implied_ids" eval="[(4, ref('group_maintenance_worker'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record rules are intentionally NOT noupdate: they must be re-applied on
         every module upgrade, otherwise a corrected domain never reaches an
         already-installed database. -->

    <record id="rule_maintenance_university_request_manager_all" model="ir.rule">
        <field name="name">Maintenance Request: Manager sees all</field>
        <field name="model_id" ref="model_maintenance_university_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_maintenance_manager'))]"/>
    </record>
    <record id="rule_maintenance_university_request_worker_own" model="ir.rule">
        <field name="name">Maintenance Request: Worker sees own</field>
        <field name="model_id" ref="model_maintenance_university_request"/>
        <field name="domain_force">[('employee_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_maintenance_worker'))]"/>
    </record>

    <record id="rule_maintenance_university_request_time_manager_all" model="ir.rule">
        <field name="name">Maintenance Request Time Log: Manager sees all</field>
        <field name="model_id" ref="model_maintenance_university_request_time"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_maintenance_manager'))]"/>
    </record>
    <record id="rule_maintenance_university_request_time_worker_own" model="ir.rule">
        <field name="name">Maintenance Request Time Log: Worker sees own</field>
        <field name="model_id" ref="model_maintenance_university_request_time"/>
        <field name="domain_force">[('request_id.employee_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_maintenance_worker'))]"/>
    </record>

    <record id="rule_maintenance_university_finding_manager_all" model="ir.rule">
        <field name="name">Inspection Finding: Manager sees all</field>
        <field name="model_id" ref="model_maintenance_university_finding"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_maintenance_manager'))]"/>
    </record>
    <record id="rule_maintenance_university_finding_worker_own" model="ir.rule">
        <field name="name">Inspection Finding: Worker sees own</field>
        <field name="model_id" ref="model_maintenance_university_finding"/>
        <field name="domain_force">[('request_id.employee_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_maintenance_worker'))]"/>
    </record>

</odoo>
