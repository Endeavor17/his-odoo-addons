<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_inherit_maintenance"
        model="ir.ui.view">

    <field name="name">hr.employee.form.maintenance</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>

    <field name="arch" type="xml">

        <!-- matricule_institutionnel n'est plus affiche ici : il appartient
             a his_hr_base, qui pose desormais sa propre vue. L'afficher aussi
             le ferait apparaitre deux fois sur le formulaire. -->
        <xpath expr="//field[@name='job_title']" position="after">
            <field name="date_start_working"/>
        </xpath>

    </field>

</record>

</odoo>