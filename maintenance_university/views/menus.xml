<odoo>
    <!-- Named "University Maintenance" so it does not collide with the root
         menu of Odoo's standard `maintenance` app. -->
    <menuitem id="menu_maintenance_root"
              name="University Maintenance"
              sequence="10"
              groups="maintenance_university.group_maintenance_worker"/>

    <menuitem id="menu_maintenance_my_work"
              name="My Work"
              parent="menu_maintenance_root"
              action="action_maintenance_university_request_my_work"
              sequence="5"
              groups="maintenance_university.group_maintenance_worker"/>

    <menuitem id="menu_maintenance_dashboard"
              name="Monthly Recap"
              parent="menu_maintenance_root"
              action="action_maintenance_university_dashboard"
              sequence="6"
              groups="maintenance_university.group_maintenance_manager"/>

    <menuitem id="menu_maintenance_request"
              name="Requests"
              parent="menu_maintenance_root"
              action="action_maintenance_university_request"
              sequence="10"
              groups="maintenance_university.group_maintenance_manager"/>

    <menuitem id="menu_maintenance_finding"
              name="Inspection Findings"
              parent="menu_maintenance_root"
              action="action_maintenance_university_finding"
              sequence="20"
              groups="maintenance_university.group_maintenance_manager"/>

    <menuitem id="menu_maintenance_worker_summary"
              name="Worker Summary"
              parent="menu_maintenance_root"
              action="action_hr_employee_maintenance_summary"
              sequence="30"
              groups="maintenance_university.group_maintenance_manager"/>

    <menuitem id="menu_maintenance_configuration"
              name="Configuration"
              parent="menu_maintenance_root"
              sequence="90"
              groups="maintenance_university.group_maintenance_manager"/>

    <menuitem id="menu_maintenance_building"
              name="Buildings"
              parent="menu_maintenance_configuration"
              action="action_maintenance_building"
              sequence="10"/>

    <menuitem id="menu_maintenance_category"
              name="Categories"
              parent="menu_maintenance_configuration"
              action="action_maintenance_category"
              sequence="20"/>

    <menuitem id="menu_maintenance_worker_create"
              name="Create Workers"
              parent="menu_maintenance_configuration"
              action="action_maintenance_university_worker_create"
              sequence="30"/>
</odoo>