<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_maintenance_university_worker_create_form" model="ir.ui.view">
        <field name="name">maintenance.university.worker.create.form</field>
        <field name="model">maintenance.university.worker.create</field>
        <field name="arch" type="xml">
            <form string="Create Workers">
                <p>
                    Add each worker's name and the login you want them to use, then click
                    Create Workers. Type a password yourself, or leave it blank to generate
                    one — either way, copy it out before closing this window, or look it up
                    again later from Worker Summary.
                </p>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="name" readonly="employee_id"/>
                        <field name="login" readonly="employee_id"/>
                        <field name="date_start_working" readonly="employee_id"/>
                        <field name="password" readonly="employee_id" placeholder="Leave blank to auto-generate"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_workers" type="object" string="Create Workers"
                            class="oe_highlight"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_maintenance_university_worker_create" model="ir.actions.act_window">
        <field name="name">Create Workers</field>
        <field name="res_model">maintenance.university.worker.create</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
