<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_maintenance_category_list" model="ir.ui.view">
        <field name="name">maintenance.category.list</field>
        <field name="model">maintenance.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="name"/>
                <field name="is_inspection"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_category_form" model="ir.ui.view">
        <field name="name">maintenance.category.form</field>
        <field name="model">maintenance.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="is_inspection"/>
                        <field name="active" invisible="1"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_maintenance_category_search" model="ir.ui.view">
        <field name="name">maintenance.category.search</field>
        <field name="model">maintenance.category</field>
        <field name="arch" type="xml">
            <search string="Categories">
                <field name="name"/>
                <filter string="Inspection Categories" name="filter_is_inspection" domain="[('is_inspection', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_maintenance_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">maintenance.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first category
            </p><p>
                Mark one "Inspection" to use it for inspection tours instead of repair requests.
            </p>
        </field>
    </record>

</odoo>
