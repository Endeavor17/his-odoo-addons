<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_maintenance_building_list" model="ir.ui.view">
        <field name="name">maintenance.building.list</field>
        <field name="model">maintenance.building</field>
        <field name="arch" type="xml">
            <list string="Buildings">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_building_form" model="ir.ui.view">
        <field name="name">maintenance.building.form</field>
        <field name="model">maintenance.building</field>
        <field name="arch" type="xml">
            <form string="Building">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_maintenance_building_search" model="ir.ui.view">
        <field name="name">maintenance.building.search</field>
        <field name="model">maintenance.building</field>
        <field name="arch" type="xml">
            <search string="Buildings">
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="action_maintenance_building" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">maintenance.building</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first building
            </p><p>
                Requests and findings are always logged against one of these.
            </p>
        </field>
    </record>

</odoo>
