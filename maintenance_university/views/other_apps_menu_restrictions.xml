<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Discuss, Employees, and core Maintenance are visible to any internal
         user in vanilla Odoo (base.group_user), and Apps/Users&Companies have
         no restriction at all. To keep a Worker's app switcher down to just
         University Maintenance, replace that blanket "any internal user"
         access with our own Manager group on all four.

         Maintenance specifically: we now depend on this module (our own
         request model inherits maintenance.request), but its own generic
         menu/views are still not what anyone should use day to day — they
         show every field unfiltered, none of our workflow/security logic.
         Hidden from everyone, Managers included, same as before this module
         depended on it at all.

         Employees keeps hr.group_hr_user / hr.group_hr_manager intact, so
         real HR staff still see it via their own HR access regardless of
         maintenance group membership.

         This is a global menu setting, not scoped to our module's users only:
         any other internal user who isn't a maintenance Manager also loses
         default access to these apps, not just maintenance workers. -->

    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="group_ids" eval="[(3, ref('base.group_user')), (4, ref('group_maintenance_manager'))]"/>
    </record>

    <record id="hr.menu_hr_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(3, ref('base.group_user')), (4, ref('group_maintenance_manager'))]"/>
    </record>

    <record id="maintenance.menu_maintenance_title" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>

    <!-- « Apps » n'est PAS sans restriction, contrairement a ce que dit le
         commentaire d'en-tete : Odoo le livre ferme sur base.group_system
         (base/views/base_menus.xml), verifie sur une base creee avec `-i base`
         seul. Le (6, 0, [...]) qui etait ici remplacait donc ce groupe natif au
         lieu de s'y ajouter, avec deux consequences :

           1. un administrateur Odoo perdait « Apps » des l'installation ;
           2. a la DESINSTALLATION, le seul groupe restant partait avec le
              module et le menu se retrouvait SANS aucun groupe — c'est-a-dire
              visible de TOUS. C'est exactement ce qui s'est produit : les
              quatre bases locales ont porte un menu « Apps » ouvert au premier
              venu jusqu'au 2026-09-06, ou his_access_base a repose le groupe.

         (4, ...) ajoute sans remplacer : le manager de maintenance voit
         « Apps », l'administrateur ne le perd pas, et une desinstallation ne
         retire que notre propre ligne. -->
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('group_maintenance_manager'))]"/>
    </record>

</odoo>
