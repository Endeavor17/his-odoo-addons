<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reporter-facing screen: same model as Inspection Findings
         (maintenance.university.finding), scoped by the Reporter's own
         ir.rule to their own standalone reports (request_id empty). No
         request_id or employee_id field here — request_id doesn't apply to a
         standalone report, and employee_id (hr.employee) isn't something a
         Reporter has read access to. No Convert button either: that stays
         manager-only on the shared Findings & Reports screen. -->

    <record id="view_maintenance_university_report_list" model="ir.ui.view">
        <field name="name">maintenance.university.finding.report.list</field>
        <field name="model">maintenance.university.finding</field>
        <field name="arch" type="xml">
            <list string="My Reports">
                <field name="building_id"/>
                <field name="category_id" domain="[('is_inspection', '=', False)]"/>
                <field name="severity"/>
                <field name="found_date"/>
                <field name="state" decoration-info="state == 'submitted'" decoration-success="state == 'converted'"/>
                <button name="action_submit" type="object" string="Submit"
                        invisible="state != 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_university_report_form" model="ir.ui.view">
        <field name="name">maintenance.university.finding.report.form</field>
        <field name="model">maintenance.university.finding</field>
        <field name="arch" type="xml">
            <form string="Report a Problem">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <field name="image_ids" widget="many2many_binary" string="Photos"
                           options="{'accepted_file_extensions': 'image/*'}"
                           readonly="state != 'draft'"/>
                    <group>
                        <group>
                            <field name="building_id" readonly="state != 'draft'"/>
                            <field name="category_id" domain="[('is_inspection', '=', False)]" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="severity" readonly="state != 'draft'"/>
                            <field name="found_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" nolabel="1" placeholder="Describe the problem..."
                               readonly="state != 'draft'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_maintenance_university_report" model="ir.actions.act_window">
        <field name="name">Report a Problem</field>
        <field name="res_model">maintenance.university.finding</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_maintenance_university_report_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_maintenance_university_report_form')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No reports yet
            </p><p>
                Spotted a problem? Log it here — a maintenance manager will review it
                and turn it into a work request.
            </p>
        </field>
    </record>

</odoo>
