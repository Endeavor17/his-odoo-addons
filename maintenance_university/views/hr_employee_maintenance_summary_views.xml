<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_maintenance_summary_list" model="ir.ui.view">
        <field name="name">hr.employee.maintenance.summary.list</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list string="Worker Summary" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="matricule_institutionnel"/>
                <field name="maintenance_workday_state"
                       decoration-success="maintenance_workday_state == 'working'"
                       decoration-warning="maintenance_workday_state == 'paused'"
                       decoration-muted="maintenance_workday_state == 'not_started'"/>
                <field name="maintenance_workday_started_at" widget="datetime" string="Started"/>
                <field name="maintenance_workday_worked_hours" widget="float_time" string="Worked Today"/>
                <field name="maintenance_workday_paused_hours" widget="float_time" string="Breaks Today"/>
                <field name="maintenance_hours_this_month" widget="float_time" sum="Total"/>
                <field name="maintenance_requests_done_this_month" sum="Total"/>
                <field name="maintenance_findings_logged_this_month" sum="Total"/>
                <field name="maintenance_findings_critical_this_month" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_maintenance_summary_form" model="ir.ui.view">
        <field name="name">hr.employee.maintenance.summary.form</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <form string="Worker Summary" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="matricule_institutionnel"/>
                    </div>
                    <group>
                        <group string="Today">
                            <field name="maintenance_workday_state" string="Status"/>
                            <field name="maintenance_workday_started_at" string="Started At"/>
                            <field name="maintenance_workday_worked_hours" widget="float_time" string="Worked"/>
                            <field name="maintenance_workday_paused_hours" widget="float_time" string="On Break"/>
                        </group>
                        <group string="This Month">
                            <field name="maintenance_hours_this_month" widget="float_time" string="Hours Worked"/>
                            <field name="maintenance_requests_done_this_month" string="Tasks Completed"/>
                            <field name="maintenance_findings_logged_this_month" string="Findings Logged"/>
                            <field name="maintenance_findings_critical_this_month" string="Critical/High Findings"/>
                        </group>
                        <group string="Login Info">
                            <field name="login"/>
                            <field name="initial_password" string="Temporary Password"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Where "when was he on a break" gets answered: each
                             day expands to its segments, and a pause carries
                             its own start and end. -->
                        <page name="maintenance_workdays" string="Work Days">
                            <field name="maintenance_workday_ids">
                                <list default_order="date desc" create="0" delete="0">
                                    <field name="date"/>
                                    <field name="date_start" widget="datetime"/>
                                    <field name="date_end" widget="datetime"/>
                                    <field name="worked_hours" widget="float_time" sum="Total Worked"/>
                                    <field name="paused_hours" widget="float_time" sum="Total Breaks"/>
                                    <field name="state"/>
                                </list>
                                <form string="Work Day">
                                    <group>
                                        <group>
                                            <field name="date"/>
                                            <field name="state"/>
                                        </group>
                                        <group>
                                            <field name="date_start"/>
                                            <field name="date_end"/>
                                            <field name="worked_hours" widget="float_time"/>
                                            <field name="paused_hours" widget="float_time"/>
                                        </group>
                                    </group>
                                    <field name="segment_ids">
                                        <list create="0" delete="0">
                                            <field name="kind"/>
                                            <field name="date_start"/>
                                            <field name="date_end"/>
                                            <field name="duration" widget="float_time"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                        <page name="maintenance_requests" string="Maintenance Requests">
                            <field name="maintenance_request_ids">
                                <list default_order="request_date desc" create="0" delete="0">
                                    <field name="name"/>
                                    <field name="building_id"/>
                                    <field name="category_id"/>
                                    <field name="state"/>
                                    <field name="request_date"/>
                                    <field name="date_end"/>
                                    <field name="duration"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_maintenance_summary" model="ir.actions.act_window">
        <field name="name">Worker Summary</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <!-- Scoped to maintenance Workers, excluding Managers (same reason as
             the dashboard's worker query): without this, every employee in
             the university showed up here, almost all with all-zero stats. -->
        <field name="domain" eval="[
            ('user_id.group_ids', 'in', ref('maintenance_university.group_maintenance_worker')),
            ('user_id.group_ids', 'not in', ref('maintenance_university.group_maintenance_manager')),
        ]"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_hr_employee_maintenance_summary_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hr_employee_maintenance_summary_form')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No employees yet
            </p>
        </field>
    </record>

</odoo>
