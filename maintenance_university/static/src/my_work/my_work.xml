<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="maintenance_university.WorkdayBanner">
        <div class="o_mu_workday d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 border-bottom bg-view"
             t-att-class="{
                'o_mu_workday_paused': dayState === 'paused',
                'o_mu_workday_done': dayState === 'done',
            }">
            <t t-if="!hasEmployee">
                <div class="text-muted">
                    Your account is not linked to an employee record, so your work day
                    cannot be clocked. Ask a maintenance manager to set one up.
                </div>
            </t>
            <t t-else="">
                <div class="d-flex align-items-center gap-3 flex-grow-1 flex-md-grow-0">
                    <span class="o_mu_workday_dot"/>
                    <div>
                        <div class="fs-4 fw-bold lh-sm">
                            <t t-if="dayState === 'working'">Working</t>
                            <t t-elif="dayState === 'paused'">On break</t>
                            <t t-elif="dayState === 'done'">Day finished</t>
                            <t t-else="">Not started</t>
                        </div>
                        <!-- On anything wider than a phone the three numbers read
                             as one line; the tiles below carry the same three when
                             there is no room for it. -->
                        <div class="text-muted small d-none d-md-block" t-if="dayState">
                            Started at <t t-esc="startedAt"/>
                            · Worked <span class="o_mu_workday_figure"><t t-esc="workedLabel"/></span>
                            · Breaks <span class="o_mu_workday_figure"><t t-esc="pausedLabel"/></span>
                        </div>
                        <div class="text-muted small" t-else="">
                            Press the button when you start your day.
                        </div>
                    </div>
                </div>

                <div class="d-flex d-md-none gap-2 w-100" t-if="dayState">
                    <div class="o_mu_workday_tile">
                        <div class="o_mu_workday_tile_label">Started</div>
                        <div class="o_mu_workday_figure" t-esc="startedAt"/>
                    </div>
                    <div class="o_mu_workday_tile">
                        <div class="o_mu_workday_tile_label">Worked</div>
                        <div class="o_mu_workday_figure" t-esc="workedLabel"/>
                    </div>
                    <div class="o_mu_workday_tile">
                        <div class="o_mu_workday_tile_label">Breaks</div>
                        <div class="o_mu_workday_figure" t-esc="pausedLabel"/>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 flex-grow-1 flex-md-grow-0 justify-content-end">
                    <button class="btn btn-lg o_mu_workday_main flex-grow-1 flex-md-grow-0"
                            t-att-disabled="state.busy or dayState === 'done'"
                            t-on-click="() => this.onPrimary()">
                        <t t-esc="primaryLabel"/>
                    </button>
                    <button t-if="dayState and dayState !== 'done'"
                            class="btn btn-lg btn-outline-secondary o_mu_workday_secondary"
                            t-att-disabled="state.busy"
                            t-on-click="() => this.onEndDay()">
                        End day
                    </button>
                </div>
            </t>
        </div>
    </t>

    <!-- Core's kanban, with the day's clock slipped in above the cards. A
         primary inherit so only the maintenance_workday_kanban js_class gets
         it; every other kanban in the database is untouched. -->
    <t t-name="maintenance_university.WorkdayKanbanView"
       t-inherit="web.KanbanView"
       t-inherit-mode="primary">
        <xpath expr="//t[@t-component='props.Renderer']" position="before">
            <WorkdayBanner/>
        </xpath>
    </t>

</templates>
