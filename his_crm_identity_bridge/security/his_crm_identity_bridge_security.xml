<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Audit S-6 : rouvre les etudiants et candidats que
         his_person_core.rule_partner_student_candidate_private ferme.
         group_sale_salesman couvre toute l'echelle Admissions : Acquisition
         l'implique, Orientation aussi (par group_sale_salesman_all_leads). -->
    <record id="rule_partner_all_salesman" model="ir.rule">
        <field name="name">Contacts : tous (admissions CRM)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
