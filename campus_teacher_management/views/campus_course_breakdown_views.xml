<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="campus_course_breakdown_view_list" model="ir.ui.view">
        <field name="name">campus.course.breakdown.list</field>
        <field name="model">campus.course.breakdown</field>
        <field name="arch" type="xml">
            <list string="Course Breakdown Submissions" delete="false">
                <field name="applicant_id"/>
                <field name="create_date" string="Submitted"/>
                <field name="filename"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'modification_requested'"
                       decoration-info="state == 'submitted'"/>
                <field name="reviewed_by" optional="show"/>
                <field name="reviewed_date" optional="hide"/>
                <button name="action_approve" type="object" string="Approve" icon="fa-check"
                        invisible="state == 'approved'"
                        groups="campus_teacher_management.group_campus_manager"
                        confirm="Approve this Course Breakdown submission?"/>
                <button name="action_request_modification" type="object" string="Request Changes"
                        icon="fa-reply"
                        invisible="state in ('approved', 'modification_requested')"/>
            </list>
        </field>
    </record>

    <record id="campus_course_breakdown_view_form" model="ir.ui.view">
        <field name="name">campus.course.breakdown.form</field>
        <field name="model">campus.course.breakdown</field>
        <field name="arch" type="xml">
            <form string="Course Breakdown Submission">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state == 'approved'"
                            groups="campus_teacher_management.group_campus_manager"
                            confirm="Approve this Course Breakdown submission?"/>
                    <button name="action_request_modification" type="object" string="Request Changes"
                            invisible="state in ('approved', 'modification_requested')"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,modification_requested,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="applicant_id"/>
                        <h1><field name="applicant_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Submission">
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="create_date" string="Submitted On" readonly="1"/>
                            <field name="create_uid" string="Submitted By" readonly="1"/>
                        </group>
                        <group string="Review">
                            <field name="reviewed_by" readonly="1"/>
                            <field name="reviewed_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="review_notes" placeholder="What needs to change — sent to the candidate when requesting a revision."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="campus_course_breakdown_view_search" model="ir.ui.view">
        <field name="name">campus.course.breakdown.search</field>
        <field name="model">campus.course.breakdown</field>
        <field name="arch" type="xml">
            <search string="Course Breakdown Submissions">
                <field name="applicant_id"/>
                <filter name="needs_review" string="Needs Review" domain="[('state', '=', 'submitted')]"/>
                <filter name="modification_requested" string="Modification Requested"
                        domain="[('state', '=', 'modification_requested')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter name="group_applicant" string="Candidate" context="{'group_by': 'applicant_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_campus_course_breakdown" model="ir.actions.act_window">
        <field name="name">Course Breakdown Reviews</field>
        <field name="res_model">campus.course.breakdown</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_needs_review': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting on a review</p>
            <p>Every Course Breakdown a candidate has sent back appears here, oldest first.
               Older versions of the same candidate's submission are kept, not overwritten —
               open the candidate's Hiring tab to see the full history.</p>
        </field>
    </record>

</odoo>
