<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="campus_shooting_program_view_list" model="ir.ui.view">
        <field name="name">campus.shooting.program.list</field>
        <field name="model">campus.shooting.program</field>
        <field name="arch" type="xml">
            <list string="Shooting Programs" create="false">
                <field name="applicant_id"/>
                <field name="session_count"/>
                <field name="recorded_count"/>
            </list>
        </field>
    </record>

    <record id="campus_shooting_program_view_form" model="ir.ui.view">
        <field name="name">campus.shooting.program.form</field>
        <field name="model">campus.shooting.program</field>
        <field name="arch" type="xml">
            <form string="Shooting Program">
                <sheet>
                    <div class="oe_title">
                        <label for="applicant_id"/>
                        <h1><field name="applicant_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="session_count"/>
                        <field name="recorded_count"/>
                    </group>
                    <separator string="Shooting Sessions"/>
                    <field name="session_ids" nolabel="1">
                        <list string="Shooting Sessions" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="title"/>
                            <field name="start_datetime"/>
                            <field name="duration" widget="float_time"/>
                            <field name="description" optional="show"/>
                            <field name="confirmed" widget="boolean_toggle"/>
                            <field name="recorded" widget="boolean_toggle"/>
                            <field name="campus_can_execute_process" invisible="1"/>
                            <field name="campus_can_validate_process" invisible="1"/>
                            <button name="action_confirm" type="object" string="Confirm" icon="fa-check"
                                    invisible="confirmed or not campus_can_execute_process"/>
                            <button name="action_mark_recorded" type="object" string="Recorded" icon="fa-video-camera"
                                    invisible="recorded or not campus_can_validate_process"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="campus_shooting_program_view_search" model="ir.ui.view">
        <field name="name">campus.shooting.program.search</field>
        <field name="model">campus.shooting.program</field>
        <field name="arch" type="xml">
            <search string="Shooting Programs">
                <field name="applicant_id"/>
                <filter name="has_sessions" string="Has Sessions" domain="[('session_count', '&gt;', 0)]"/>
                <filter name="none_recorded" string="Nothing Recorded Yet" domain="[('recorded_count', '=', 0)]"/>
            </search>
        </field>
    </record>

    <record id="action_campus_shooting_program" model="ir.actions.act_window">
        <field name="name">Shooting</field>
        <field name="res_model">campus.shooting.program</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Shooting Programs yet</p>
            <p>A teacher gets their own Shooting Program automatically once their contract
               is marked signed. Open one to see and manage their recording sessions.</p>
        </field>
    </record>

</odoo>
