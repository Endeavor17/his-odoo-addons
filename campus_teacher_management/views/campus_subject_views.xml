<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="campus_subject_view_list" model="ir.ui.view">
        <field name="name">campus.subject.list</field>
        <field name="model">campus.subject</field>
        <field name="arch" type="xml">
            <list string="Subjects" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="level"/>
                <field name="track"/>
                <field name="language"/>
                <field name="application_count" string="Applications" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="campus_subject_view_form" model="ir.ui.view">
        <field name="name">campus.subject.form</field>
        <field name="model">campus.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="level"/>
                            <field name="language"/>
                        </group>
                        <group>
                            <field name="track"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="campus_subject_view_search" model="ir.ui.view">
        <field name="name">campus.subject.search</field>
        <field name="model">campus.subject</field>
        <field name="arch" type="xml">
            <search string="Subjects">
                <field name="name"/>
                <field name="code"/>
                <field name="track"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_level" string="Level" context="{'group_by': 'level'}"/>
                    <filter name="group_language" string="Language" context="{'group_by': 'language'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_campus_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">campus.subject</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a subject</p>
            <p>The catalogue candidates choose from. The external code is what the web
               form sends, so keep it stable once applications have referenced it.</p>
        </field>
    </record>

</odoo>
