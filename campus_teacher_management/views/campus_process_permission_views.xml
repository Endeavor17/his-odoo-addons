<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="campus_process_permission_view_list" model="ir.ui.view">
        <field name="name">campus.process.permission.list</field>
        <field name="model">campus.process.permission</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="process_id"/>
                <field name="user_id"/>
                <field name="can_view"/>
                <field name="can_execute"/>
                <field name="can_validate"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="campus_process_permission_view_form" model="ir.ui.view">
        <field name="name">campus.process.permission.form</field>
        <field name="model">campus.process.permission</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="process_id"/>
                        <field name="user_id"/>
                        <field name="can_view"/>
                        <field name="can_execute"/>
                        <field name="can_validate"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="campus_process_permission_view_search" model="ir.ui.view">
        <field name="name">campus.process.permission.search</field>
        <field name="model">campus.process.permission</field>
        <field name="arch" type="xml">
            <search>
                <field name="process_id"/>
                <field name="user_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_process" string="Process" context="{'group_by': 'process_id'}"/>
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_campus_process_permission" model="ir.actions.act_window">
        <field name="name">Process Permissions — Campus+</field>
        <field name="res_model">campus.process.permission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('process_id.family', '=', 'campus')]</field>
        <field name="context">{'search_default_group_by_process': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Grant a user access to a Campus+ process</p>
            <p>For each Campus+ Recruitment process (Dashboard, Candidatures, 1er Interview,
               2ème Interview, Course Breakdown, Contrat, Shooting), pick which users can
               View, Execute and Validate it. Validate needs Execute, Execute needs View —
               ticking one turns the others on automatically. InSite's own processes have
               their own separate "Process Permissions — InSite" menu.</p>
        </field>
    </record>

</odoo>
