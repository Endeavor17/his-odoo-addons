<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="campus_shooting_session_view_list" model="ir.ui.view">
        <field name="name">campus.shooting.session.list</field>
        <field name="model">campus.shooting.session</field>
        <field name="arch" type="xml">
            <list string="Shooting Sessions" decoration-success="recorded" decoration-muted="not confirmed">
                <field name="applicant_id"/>
                <field name="title"/>
                <field name="start_datetime"/>
                <field name="duration" widget="float_time" optional="hide"/>
                <field name="confirmed" widget="boolean_toggle"/>
                <field name="recorded" widget="boolean_toggle"/>
                <field name="campus_can_execute_process" column_invisible="1"/>
                <field name="campus_can_validate_process" column_invisible="1"/>
                <button name="action_confirm" type="object" string="Confirm" icon="fa-check"
                        invisible="confirmed or not campus_can_execute_process"/>
                <button name="action_mark_recorded" type="object" string="Recorded" icon="fa-video-camera"
                        invisible="recorded or not campus_can_validate_process"/>
            </list>
        </field>
    </record>

    <record id="campus_shooting_session_view_calendar" model="ir.ui.view">
        <field name="name">campus.shooting.session.calendar</field>
        <field name="model">campus.shooting.session</field>
        <field name="arch" type="xml">
            <calendar string="Shooting Sessions" date_start="start_datetime" date_stop="end_datetime"
                      mode="week" color="applicant_id" quick_create="0">
                <field name="applicant_id"/>
                <field name="title"/>
                <field name="confirmed"/>
                <field name="recorded"/>
            </calendar>
        </field>
    </record>

    <record id="campus_shooting_session_view_form" model="ir.ui.view">
        <field name="name">campus.shooting.session.form</field>
        <field name="model">campus.shooting.session</field>
        <field name="arch" type="xml">
            <form string="Shooting Session">
                <header>
                    <field name="campus_can_execute_process" invisible="1"/>
                    <field name="campus_can_validate_process" invisible="1"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="confirmed or not campus_can_execute_process"/>
                    <button name="action_mark_recorded" type="object" string="Mark Recorded"
                            class="btn-primary" invisible="recorded or not campus_can_validate_process"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title"/></h1>
                    </div>
                    <group>
                        <group string="For">
                            <field name="applicant_id"/>
                        </group>
                        <group string="When">
                            <field name="start_datetime"/>
                            <field name="duration" widget="float_time"/>
                            <field name="end_datetime" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Status">
                            <field name="confirmed" widget="boolean_toggle"/>
                            <field name="confirmed_date" readonly="1" invisible="not confirmed_date"/>
                            <field name="recorded" widget="boolean_toggle"/>
                            <field name="recorded_date" readonly="1" invisible="not recorded_date"/>
                        </group>
                    </group>
                    <separator string="Description"/>
                    <p class="text-muted">What the teacher needs to record during this session — sent to them by email.</p>
                    <field name="description" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="campus_shooting_session_view_search" model="ir.ui.view">
        <field name="name">campus.shooting.session.search</field>
        <field name="model">campus.shooting.session</field>
        <field name="arch" type="xml">
            <search string="Shooting Sessions">
                <field name="applicant_id"/>
                <field name="title"/>
                <filter name="unconfirmed" string="Not Confirmed" domain="[('confirmed', '=', False)]"/>
                <filter name="confirmed" string="Confirmed" domain="[('confirmed', '=', True)]"/>
                <separator/>
                <filter name="not_recorded" string="Not Recorded" domain="[('recorded', '=', False)]"/>
                <filter name="recorded" string="Recorded" domain="[('recorded', '=', True)]"/>
                <separator/>
                <filter name="upcoming" string="Upcoming"
                        domain="[('start_datetime', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_applicant" string="Candidate" context="{'group_by': 'applicant_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'start_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_campus_shooting_session" model="ir.actions.act_window">
        <field name="name">Shooting Sessions</field>
        <field name="res_model">campus.shooting.session</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_upcoming': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No recording sessions scheduled yet</p>
            <p>Sessions are usually created from the candidate's Hiring tab once they reach
               the Shooting stage. Creating or editing one here notifies the candidate by
               email automatically.</p>
        </field>
    </record>

</odoo>
