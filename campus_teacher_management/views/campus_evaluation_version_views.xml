<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="campus_evaluation_version_view_list" model="ir.ui.view">
        <field name="name">campus.evaluation.version.list</field>
        <field name="model">campus.evaluation.version</field>
        <field name="arch" type="xml">
            <list string="Evaluation Versions">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="version"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'closed'"/>
                <field name="weighting_method"/>
                <field name="normalize" string="Normalized"/>
                <field name="criterion_count" string="Criteria"/>
                <field name="application_count" string="Applications"/>
                <field name="date_published" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="campus_evaluation_version_view_form" model="ir.ui.view">
        <field name="name">campus.evaluation.version.form</field>
        <field name="model">campus.evaluation.version</field>
        <field name="arch" type="xml">
            <form string="Evaluation Version">
                <header>
                    <button name="action_publish" type="object" string="Publish"
                            class="btn-primary" invisible="state != 'draft'"
                            confirm="Publishing freezes the criteria, scales and priorities of this version. Continue?"/>
                    <button name="action_new_version" type="object" string="New Version"
                            invisible="state == 'draft'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'published'"/>
                    <button name="action_evaluate_all" type="object" string="Re-evaluate All"
                            invisible="state == 'draft' or application_count == 0"
                            confirm="Re-score every unlocked application in this version?"/>
                    <button name="action_recompute_ranks" type="object" string="Recompute Ranking"
                            invisible="application_count == 0"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_applications" type="object"
                                class="oe_stat_button" icon="fa-users"
                                invisible="not application_count">
                            <field name="application_count" widget="statinfo" string="Applications"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Campus+ 2026/2027"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state == 'draft'">
                        This version is <field name="state" readonly="1" nolabel="1" class="oe_inline"/>.
                        Its criteria, scales and priorities are read-only so applications already
                        scored under it cannot change. Use <b>New Version</b> to make an editable copy.
                    </div>
                    <group>
                        <group string="Scoring">
                            <field name="version"/>
                            <field name="origin_id" readonly="1" invisible="not origin_id"/>
                            <field name="weighting_method"/>
                            <field name="normalize"/>
                            <field name="years_cap"/>
                        </group>
                        <group string="Lifecycle">
                            <field name="job_id"
                                   help="Set this so incoming applications get a recruitment stage."/>
                            <field name="date_published" readonly="1"/>
                            <field name="date_closed" readonly="1"/>
                            <field name="total_weight" readonly="1"
                                   help="Weights across a version always sum to 1."/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Criteria" name="criteria">
                            <field name="criterion_ids" nolabel="1"
                                   context="{'default_version_id': id}">
                                <list string="Criteria" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="value_type"/>
                                    <field name="source_key"/>
                                    <field name="priority"/>
                                    <field name="max_score"/>
                                    <field name="scale_count" string="Scale"/>
                                    <field name="weight_percent" string="Weight %" readonly="1"/>
                                </list>
                            </field>
                            <p class="text-muted mt-2">
                                Weights are derived from priorities by the CAR algorithm and always
                                sum to 100%. Higher priority means a higher weight; equal priorities
                                receive equal weight under the corrected method.
                            </p>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="campus_evaluation_version_view_search" model="ir.ui.view">
        <field name="name">campus.evaluation.version.search</field>
        <field name="model">campus.evaluation.version</field>
        <field name="arch" type="xml">
            <search string="Evaluation Versions">
                <field name="name"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_campus_evaluation_version" model="ir.actions.act_window">
        <field name="name">Evaluation Versions</field>
        <field name="res_model">campus.evaluation.version</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an evaluation version</p>
            <p>A version holds the criteria, scales and priorities for one recruitment
               campaign. Publishing it freezes them so past rankings stay reproducible.</p>
        </field>
    </record>

</odoo>
