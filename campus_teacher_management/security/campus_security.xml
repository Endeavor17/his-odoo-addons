<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_campus_teacher" model="ir.module.category">
        <field name="name">Campus+ Recruitment</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_campus" model="res.groups.privilege">
        <field name="name">Campus+ Recruitment</field>
        <field name="category_id" ref="module_category_campus_teacher"/>
    </record>

    <!-- Recruiters build on the standard recruitment officer role rather than a
         parallel permission system, so anything hr_recruitment already grants
         (stages, refuse reasons, chatter, activities) keeps working. -->
    <record id="group_campus_recruiter" model="res.groups">
        <field name="name">Recruiter</field>
        <field name="sequence">10</field>
        <field name="comment">Reads the evaluation configuration, manages applications,
            accepts or refuses candidates and assigns subjects.</field>
        <field name="privilege_id" ref="res_groups_privilege_campus"/>
        <field name="implied_ids" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
    </record>

    <record id="group_campus_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="comment">Everything a recruiter can do, plus editing criteria,
            scales, priorities, publishing versions and recalculating scores.</field>
        <field name="privilege_id" ref="res_groups_privilege_campus"/>
        <field name="implied_ids" eval="[(4, ref('group_campus_recruiter'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record rules are intentionally NOT noupdate: they must be re-applied on
         every module upgrade, otherwise a corrected domain never reaches an
         already-installed database. -->

    <record id="rule_campus_submission_manager" model="ir.rule">
        <field name="name">Campus+ Submission: managers only</field>
        <field name="model_id" ref="model_campus_submission"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_campus_manager'))]"/>
    </record>

    <record id="rule_campus_process_permission_manager" model="ir.rule">
        <field name="name">Campus+ Process Permission: managers only</field>
        <field name="model_id" ref="model_campus_process_permission"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_campus_manager'))]"/>
    </record>

    <!-- The real, RPC-proof view gate (section 11/13 of the spec this module's
         Process Permission system implements): an applicant whose current
         Campus+ process the user cannot view is filtered out of every list
         and raises AccessError the instant it's opened by id, exactly like
         any other ir.rule. campus_process_id = False for non-Campus+ jobs, so
         other recruiters are unaffected.

         Deliberately GLOBAL (no groups): hr_recruitment ships its own
         "User: All Applicants" rule on group_hr_recruitment_user
         ([(1,'=',1)] for that group) which group_campus_recruiter implies.
         ir.rule OR's together every group-scoped rule that applies to a
         user before AND-ing that with the global rules, so a group-scoped
         version of this rule would simply be OR'd away by that permissive
         one and restrict nothing. A global rule is AND-ed unconditionally
         instead, which is what actually enforces the restriction. -->
    <record id="rule_campus_applicant_process_view" model="ir.rule">
        <field name="name">Campus+ Applicant: process view permission</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="domain_force">['|', ('campus_process_id', '=', False),
            ('campus_process_id', 'in', user.env['campus.process.permission'].sudo().search([
                ('user_id', '=', user.id), ('can_view', '=', True), ('active', '=', True),
            ]).process_id.ids)]</field>
        <!-- Explicitly cleared (not just omitted): omitting this field on an
             already-existing xmlid record leaves whatever groups an earlier
             version of this rule set, it does not reset it to empty. -->
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

</odoo>
