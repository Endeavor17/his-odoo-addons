#. module: campus_teacher_management
#: model:mail.template,body_html:campus_teacher_management.mail_template_campus_cb_modification
msgid ""
"<div style=\"font-family:Figtree,'Segoe UI',Tahoma,Arial,sans-serif;font-size:14px;color:#1A2340;line-height:1.7;\">\n"
"    <p>Dear <t t-out=\"object.applicant_id.campus_name_lat or object.applicant_id.partner_name or ''\">Teacher</t>,</p>\n"
"\n"
"    <p>\n"
"        Thank you for sending your Course Breakdown. Before we can approve it, a few\n"
"        changes are needed:\n"
"    </p>\n"
"\n"
"    <div style=\"padding:10px 14px;border:1px solid #DDE4F0;background:#F5F7FC;white-space:pre-wrap;\">\n"
"        <t t-out=\"object.review_notes\"/>\n"
"    </div>\n"
"\n"
"    <p>Please send us a revised version once it is ready.</p>\n"
"\n"
"    <p>Kind regards,<br/>The Campus+ team</p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"font-family:Figtree,'Segoe UI',Tahoma,Arial,sans-serif;font-size:14px;color:#1A2340;line-height:1.7;\">\n"
"    <p>Bonjour <t t-out=\"object.applicant_id.campus_name_lat or object.applicant_id.partner_name or ''\">Enseignant</t>,</p>\n"
"\n"
"    <p>\n"
"        Merci de nous avoir envoyé votre découpage du cours. Avant de pouvoir l'approuver,\n"
"        quelques modifications sont nécessaires :\n"
"    </p>\n"
"\n"
"    <div style=\"padding:10px 14px;border:1px solid #DDE4F0;background:#F5F7FC;white-space:pre-wrap;\">\n"
"        <t t-out=\"object.review_notes\"/>\n"
"    </div>\n"
"\n"
"    <p>Merci de nous envoyer une version révisée dès qu'elle sera prête.</p>\n"
"\n"
"    <p>Cordialement,<br/>L'équipe Campus+</p>\n"
"</div>\n"
"            "

